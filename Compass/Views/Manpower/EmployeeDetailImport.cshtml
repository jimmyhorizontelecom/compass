@using System.Security.Claims
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var roleId = User.FindFirst("RoleId")?.Value;
    var userId = User.FindFirst("UserId")?.Value;
    var deptId = User.FindFirst("DeptId")?.Value;
}
@{
    Layout = "~/Views/Shared/_TestLayout.cshtml";
}
<div class="container-fluid ">
    <div id="modalLoader1" class="modal-loader modalLoader">
        <div class="spinner"></div>
        <p class="loading-text">Please wait...</p>
    </div>
    <h4>Employee Detail Import </h4>
    <div class="filter-panel mt-2 div-coral-base d-flex ">
        <div style="width:70%">
            <strong>Steps to Upload Employee Excel:</strong> <br>
            1. <strong>Download Template</strong><br />
            2. Prepare your employee data in that Excel file ⚠ Excel file must be created Work Order wise <br />
            (For Designation Write DesigntionID as Mention in this Sheet) <br />
            <button type="button" class="btn btnModel btnDownloadDesignationSheet" style="width:max-content">Download Designation Code Excel Sheet</button><br />
            3. Select <strong>Agency</strong> <br />
            4. Select <strong> Department</strong> <br />
            5. Select <strong>Work Order</strong><br />
            6. Upload <strong> Excel File </strong><br />
            7. Click on <strong> View </strong> to check records<br />
            8. Click on <strong> Verify </strong> to validate data <br />
            9. If all records are correct → Click <strong>Upload</strong><br />
            <strong> If you want to add employees manually, click on the ADD Employee Details button on the side.</strong>
        </div>
        <div style="width:30%; display:flex; justify-content:flex-end; align-items:center;">
            <button type="button" class="btn btnModel btnAddEmployeeDetails" style="width:max-content">+ Add Employee Details</button><br />
        </div>
    </div>
</div>
<div class="container-fluid mt-2">
    <div class="filter-panel mt-2 div-coral-base">
        <div class="form-group row">
            <div class="col-md-2 mb-0 d-flex justify-content-center align-items-center">
                <label class="form-labelo"> <span class="text-danger">.</span></label>
                <button type="button" class="btn btnModel btnDownloadTemplate" style="width:max-content">Download Template</button>
            </div>
            <div class="col-md-2 mb-0">
                <label class="form-labelo">Agency<span class="text-danger">*</span></label>
                <select id="ddlAgencyFilter" class="form-select search_ddl select2" aria-label=".form-select-sm">
                    <option selected value="0">--Select--</option>
                </select>
                <span class="error"></span>
            </div>
            <div class="col-md-2 mb-0">
                <label class="form-labelo">Department Name<span class="text-danger">*</span></label>
                <select id="ddlDeptFilter" class="form-select search_ddl select2" aria-label=".form-select-sm">
                    <option selected value="0"> -- Select --</option>
                </select>
                <span class="error"></span>
            </div>
            <div class="col-md-2 mb-0">
                <label class="form-labelo">Work Order No<span class="text-danger">*</span></label>
                <select id="ddlWorkOrder" class="form-select search_ddl select2" aria-label=".form-select-sm">
                    <option selected value="0"> -- Select --</option>
                </select>
                <span class="error"></span>
            </div>
            <div class="col-md-2 mb-0">
                <label class="form-label">No. of Resources<span class="text-danger">*</span></label>
                <input type="text" id="txtNoofResources" class="form-control txtbx cleartxt" placeholder="No. of Resources" readonly />
                <span class="error"></span>
            </div>
            <div class="col-md-2 mb-0">
                <label class="form-label">Choose File<span class="text-danger">*</span></label>
                <div class="input-group mb-0">
                    <input type="file" class="form-control" id="inputUploadEmpImportFileAttached" accept=".xlsx,.xls" placeholder="DesignationCodeExcelSheet">
                </div>
                <span class="error text-danger"></span>
            </div>
        </div>
        <div class="form-group row">
            <div class="col-md-2 mb-0 d-flex justify-content-between">
                <button type="button" id="btnViewExcel" class="btn btnModel btnViewFile mx-4" style="width:max-content">View</button>
                <button type="button" class="btn btnModel btnVerifyFile mx-4" style="width:max-content">Verify</button>
            </div>
        </div>
    </div>
    <div class="filter-panel mt-2 div-coral-base">
        <table id="myTable" class="table orangeTh table-striped table-hover table-bordered">
            <thead class="bg-d">
                <tr>
                    <th>Sr.No</th>
                    <th>EmpName</th>
                    <th>Father's Name</th>
                    <th>Is Full Timer</th>
                    <th>Designation Id </th>
                    <th>AADHAR</th>
                    <th>Basic</th>
                    <th>Others</th>
                    <th>Is Pf</th>
                    <th>Is ESI</th>
                    <th>Status</th>
                    <th>Error</th>
                    <th>Remove</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="tfoot bg-primary">
                <tr>
                    @* <td>3</td>
                    <td>Mike Brown</td>
                    <td>mike@example.com</td>
                    <td>Editor</td>
                    <td>Editor</td> *@
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="form-group row">
        <div class="col-md-10 mb-0">
         
        </div>
        <div class="col-md-2 mb-0 d-flex justify-content-between">
            @* <button type="button" id="btnViewExcel" class="btn btnModel btnViewFile mx-4" style="width:max-content">View</button> *@
            <button type="button" class="btn btnModel btnSubmitTableData mx-4" style="width:max-content">Submit</button>
        </div>
    </div>
</div>
}
@section Modals {
    <!-- The Modal -->
    <!-- Add Employee Details-->
    <div class="modal modal-lg" id="myModal_AddEmployee">
        <div class="modal-dialog ">
            <div class="modal-content position-relative">
                <!-- 🔥 Loader Overlay -->
                <div id="" class="modal-loader modalLoader">
                    <div class="spinner"></div>
                    <p class="loading-text">Please wait...</p>
                </div>
                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel">Add Employee Details</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>
                <!-- Modal body -->
                <div class="modal-body">
                    <div id="#toast-container"></div>
                    <div class="filter-panel mt-5 div-coral-base">
                        <div class="form-group row">
                            <div class="col-md-4 mb-0">
                                <label class="form-labelo">Agency<span class="text-danger">*</span></label>
                                <select id="ddlAgencyName" class="form-select search_ddl select2" aria-label=".form-select-sm">
                                    <option selected value="0">--Select--</option>
                                </select>
                                <span class="error"></span>
                            </div>
                            <div class="col-md-4 mb-0">
                                <label class="form-labelo">Department Name<span class="text-danger">*</span></label>
                                <select id="ddlDeptName" class="form-select search_ddl select2" aria-label=".form-select-sm">
                                    <option selected value="0"> -- Select --</option>
                                </select>
                                <span class="error"></span>
                            </div>
                            <div class="col-md-4 mb-0">
                                <label class="form-labelo">Work Order No<span class="text-danger">*</span></label>
                                <select id="ddlWorkOrder1" class="form-select search_ddl select2" aria-label=".form-select-sm">
                                    <option selected value="0"> -- Select --</option>
                                </select>
                                <span class="error"></span>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4 mb-0">
                                    <label class="form-label">Employee Name<span class="text-danger">*</span></label>
                                    <input type="text" id="txtEmpName" class="form-control txtbx cleartxt" placeholder="Employee Name"  />
                                    <span class="error"></span>
                                </div>
                                <div class="col-md-4 mb-0">
                                    <label class="form-label">Father/Husband Name<span class="text-danger">*</span></label>
                                    <input type="text" id="txtFathersName" class="form-control txtbx cleartxt" placeholder="Father's/Husband Name'"  />
                                    <span class="error"></span>
                                </div>
                                <div class="col-md-4 mb-0">
                                    <label class="form-label">Mobile No.<span class="text-danger">*</span></label>
                                    <input type="number" id="numMobileNo" class="form-control txtbx cleartxt" placeholder="Mobile No."  />
                                    <span class="error"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4 mb-0">
                                    <label class="form-label">Email Id<span class="text-danger">*</span></label>
                                    <input type="text" id="txtEmailId" class="form-control txtbx cleartxt" placeholder="Email Id" />
                                    <span class="error"></span>
                                </div>
                                <div class="col-md-4 mb-0">
                                    <label class="form-label">Adhaar No.<span class="text-danger">*</span></label>
                                    <input type="number" id="numAdhaarNo" class="form-control txtbx cleartxt" placeholder="Adhaar No." />
                                    <span class="error"></span>
                                </div>
                                <div class="col-md-4 mb-0">
                                    <label class="form-labelo">Designation<span class="text-danger">*</span></label>
                                    <select id="ddlDesignation" class="form-select search_ddl select2" aria-label=".form-select-sm">
                                        <option selected value="0"> -- Select --</option>
                                    </select>
                                    <span class="error"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4 mb-0">
                                    <label class="form-label">Bank Account no.<span class="text-danger">*</span></label>
                                    <input type="number" id="numBankACNo" class="form-control txtbx cleartxt" placeholder="Bank Account no." />
                                    <span class="error"></span>
                                </div>
                                <div class="col-md-4 mb-0">
                                    <label class="form-label">IIFSC Code<span class="text-danger">*</span></label>
                                    <input type="text" id="txtIfscCode" class="form-control txtbx cleartxt" placeholder="IFSC Code" />
                                    <span class="error"></span>
                                </div>
                                <div class="col-md-4 mb-0">
                                    <label class="form-label">UAN No.<span class="text-danger">*</span></label>
                                    <input type="number" id="numUanNo" class="form-control txtbx cleartxt" placeholder="UAN No." />
                                    <span class="error"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4 mb-0">
                                    <label class="form-label">ESIC (IP No.)<span class="text-danger">*</span></label>
                                    <input type="number" id="numEsiNo" class="form-control txtbx cleartxt" placeholder="ESIC No." />
                                    <span class="error"></span>
                                </div>
                                <div class="col-md-4 mb-0">
                                    <label class="form-labelo">Educational Level<span class="text-danger">*</span></label>
                                    <select id="ddlEducation" class="form-select search_ddl select2" aria-label=".form-select-sm">
                                        <option selected value="0"> -- Select --</option>
                                    </select>
                                    <span class="error"></span>
                                </div>
                                <div class="col-md-4 mb-0">
                                    <input class="form-check-input" type="checkbox" id="chkFullTimeEmp">
                                    <label class="form-check-label" for="chkActive"> Is Full Time Employee </label>
                                    <span class="error"></span>
                                </div>
                            </div>
                        </div>
                        <div class="filter-panel mt-5 div-coral-base">
                            <div class="form-group row">
                                <div class="col-md-4 mb-0">
                                    <label class="form-label">Basic Salary<span class="text-danger">*</span></label>
                                    <input type="number" id="numBasicSalary" class="form-control txtbx cleartxt" placeholder="Basic Salary" />
                                    <span class="error"></span>
                                </div>
                                <div class="col-md-4 mb-0">
                                    <input class="form-check-input" type="checkbox" id="chkEPF">
                                    <label class="form-check-label" for="chkActive"> EPF 13% </label>
                                    <span class="error"></span>
                                </div>
                                <div class="col-md-4 mb-0">
                                    <input class="form-check-input" type="checkbox" id="chkESIC">
                                    <label class="form-check-label" for="chkActive"> ESIC 3.25% </label>
                                    <span class="error"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-4 mb-0">
                                    <label class="form-label">Other Allowance<span class="text-danger">*</span></label>
                                    <input type="number" id="numAllowance" class="form-control txtbx cleartxt" placeholder="Other Allowance" />
                                    <span class="error"></span>
                                </div>
                                <div class="col-md-4 mb-0">
                                    <label class="form-label">Total Amount<span class="text-danger">*</span></label>
                                    <input type="number" id="numTotalAmt" class="form-control txtbx cleartxt" placeholder="Total Amount" readonly/>
                                    <span class="error"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Modal footer -->
                    <div class="modal-footer  bg-ld">
                        <div class="me-auto">
                            <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                        </div>
                        <div class="flex-grow-1 text-center modelalert text-danger"></div>
                        <button type="button" class="btn btnModel btnModalAddEmpSubmit">Submit</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/PageAssets/Manpower/Js/employeedetailimport.js" asp-append-version="true"></script>
    <script>
        var UserRole = '@roleId';
        var UserId = '@userId';
        var DeptId = '@deptId';
    </script>
}
