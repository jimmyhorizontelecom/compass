@using System.Security.Claims
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var roleId = User.FindFirst("RoleId")?.Value;
    var userId = User.FindFirst("UserId")?.Value;
    var deptId = User.FindFirst("DeptId")?.Value;
    var agencyId = User.FindFirst("AgencyId")?.Value;

}
@{
    Layout = "~/Views/Shared/_TestLayout.cshtml";
}
<div class="alert alert-info">
    Agency Id: @agencyId
</div>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Claim Type</th>
            <th>Claim Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var claim in User.Claims)
        {
            <tr>
                <td>@claim.Type</td>
                <td>@claim.Value</td>
            </tr>
        }
    </tbody>
</table>
<div class="container-fluid ">
    <div id="modalLoader1" class="modal-loader modalLoader">
        <div class="spinner"></div>
        <p class="loading-text">Please wait...</p>

    </div>
    <h4>Department Billing Address </h4>

    <div class="filter-panel mt-5 div-coral-base">
        <div class="row">
            @* <div class="col-md-2">
                <label class="form-labelo">Agency<span class="text-danger">*</span></label>
                <select id="ddlAgencyFilter" class="form-select search_ddl select2" aria-label=".form-select-sm">
                    <option selected value="0">Select</option>
                </select>
                <span class="error"></span>
            </div>
            <div class="col-md-2">
                <label class="form-labelo">Department<span class="text-danger">*</span></label>
                <select id="ddlDeptFilter" class="form-select search_ddl select2" aria-label=".form-select-sm">
                    <option selected value="0">Select</option>
                </select>
                <span class="error"></span>
            </div> *@
            <div class="col-md-2">
                <label class="form-labelo">Work Order Filter<span class="text-danger">*</span></label>
                <select id="ddlWorkOrderFilter" class="form-select" aria-label=".form-select-sm">
                    @* <option selected value="0">Select</option> *@
                    <option selected="" value="Y">Active WorkOrder</option>
                    <option value="N">DeActive WorkOrder</option>
                    <option value="A"> All </option>
                     </select>
                 <span class="error"></span>
            </div>
            <div class="col-md-8"> </div>
            <div class="col-md-2 align-content-center">
                     <button type="button" class="btn  btn-coral txt-white " data-bs-toggle="modal" data-bs-target="#myModal" >
                    <i class="bi bi-plus-circle-fill" style="margin-right:5px"></i>Add Work Order Details
                </button>
                @* <button type="button" class="btn  btn-coral txt-white" data-bs-toggle="modal" data-bs-target="#myModalTab">
                    Open tab modal
                </button> *@

            </div>
        </div>
    </div>
    <div class="container-fluid mt-5">
        @* <h2 class="mb-4">User List</h2> *@
        <div class="filter-panel mt-5 div-coral-base">
            <table id="myTable" class="table orangeTh table-striped table-hover table-bordered">
                <thead class="bg-d">
                    <tr>
                        <th>Sr.No</th>
                        <th>Agency Name</th>
                        <th>Department Name</th>
                        <th>Work Order No.</th>
                        <th>Billing Address</th>
                        <th>No. Of Reesources</th>
                        <th>Is Employees Uploaded</th>
                        <th>No. Of Uploaded Resource</th>
                        <th>Edit</th>
                        <th>Deactivate Work Order</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
                <tfoot class="tfoot bg-primary">
                    <tr>
                        @* <td>3</td>
                    <td>Mike Brown</td>
                    <td>mike@example.com</td>
                    <td>Editor</td>
                    <td>Editor</td> *@
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
@section Modals {
   <!-- The Modal -->
    <div class="modal modal-lg" id="myModal">
        <div class="modal-dialog ">
            <div class="modal-content position-relative">
                <!-- 🔥 Loader Overlay -->
                <div id="" class="modal-loader modalLoader">
                    <div class="spinner"></div>
                    <p class="loading-text">Please wait...</p>
                </div>
                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel">Add Department Email & Billing Address</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body">
                    <div id="#toast-container"></div>
                    <div class="form-group row">

                        <div class="col-md-6 mb-0">
                            <label class="form-labelo">Agency<span class="text-danger">*</span></label>
                            <input type="hidden" id="hdnAgencyId">
                            <select id="ddlAgencyName" class="form-select search_ddl select2" aria-label=".form-select-sm">
                            <option selected value="0">Select</option>
                        </select>
                        <span class="error"></span>
                    </div>
                        <div class="col-md-6 mb-0">
                            <label class="form-labelo">Department<span class="text-danger">*</span></label>
                            <input type="hidden" id="hdnDeptId">
                            <select id="ddlDeptName" class="form-select search_ddl select2" aria-label=".form-select-sm">
                                <option selected value="0">Select</option>
                            </select>
                            <span class="error"></span>
                        </div>
                    </div>
                    <div class="form-group row mt-0 mb-0">
                        <div class="col-md-6 mt-0">
                            <label class="form-label">Work Order No<span class="text-danger">*</span></label>
                            <input type="text" id="txtworkOrderNo" class="form-control txtbx cleartxt" placeholder="Work Order No" />
                            <span class="error mb-0"></span>
                        </div>

                        <div class="col-md-6 mt-0">
                            <label class="form-label">No of Resources<span class="text-danger">*</span></label>
                            <input type="text" id="txtnoOfResources" class="form-control txtbx cleartxt" placeholder="No Of Resources" />
                            <span class="error mb-0"></span>
                        </div>
                    </div>
                    <div class="form-group row mt-0 mb-0">
                        <div class="col-md-6 mb-0">
                            <label class="form-label">Department Email Id<span class="text-danger">*</span></label>
                            <input type="text" id="txtdeptEmailId" class="form-control txtbx cleartxt" placeholder="Department Email Id" />
                            <span class="error"></span>
                        </div>
                    </div>
                    <div class="form-group row mt-0 mb-0">
                        <div class="col-md-12 mb-0">
                            <label class="form-labelo">Billing Address<span class="text-danger">*</span></label>
                            <select id="ddlBillingAddress" class="form-select search_ddl select2" aria-label=".form-select-sm">
                                <option selected value="0">Select</option>
                            </select>
                            <span class="error"></span>
                        </div>
                    </div>
                </div>

                <!-- Modal footer -->
                <div class="modal-footer  bg-ld">
                    <div class="me-auto">
                        <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                    </div>
                    <div class="flex-grow-1 text-center modelalert text-danger"></div>
                    <button type="button" class="btn btnModel btnModalSubmit">Submit</button>
                    <button type="button" data-bs-dismiss="modal" class="btn btnModel">Close</button>

                </div>

            </div>
        </div>
    </div>
 
   
}

@section Scripts {
    
    <script src="~/pageassets/manpower/js/addworkorder.js"></script>
}
