@{
    var roleId = User.FindFirst("RoleId")?.Value;
    var userId = User.FindFirst("UserId")?.Value;
    var deptId = User.FindFirst("DeptId")?.Value;
}
@{
    Layout = "~/Views/Shared/_TestLayout.cshtml";
}
@* <style>
    .select2-container {
        z-index: 9999 !important;
    }
</style> *@

<div class="container">
    <h2 class="mb-4 text-center">Brand List</h2>
    <div class="filter-panel mt-5">
        <div class="row">
            <div class="col-md-2 ">
                <label class="form-label">Main Category<span class="text-danger">*</span></label>
                <select id="ddlMainCategoryFilter" class="form-select search_ddl select2" aria-label=".form-select-sm">
                </select>
            </div>
            <div class="col-md-2 ">
                <label class="form-label">Product Category<span class="text-danger">*</span></label>
                <select id="ddlProductCategoryFilter" class="form-select search_ddl select2" aria-label=".form-select-sm">
                </select>
            </div>
            <div class="col-md-2 ">
                <label class="form-label">Brand<span class="text-danger">*</span></label>
                <select id="ddlBrandFilter" class="form-select search_ddl select2" aria-label=".form-select-sm">
                </select>
            </div>
            <div class="col-md-2 ">
                <label class="form-label">Active Status<span class="text-danger">*</span></label>
                <select id="" class="form-select " aria-label=".form-select-sm">
                    <option selected value="0"> -- Select --</option>
                    <option value="Y"> Activated</option>
                    <option value="N">Deactivated</option>
                </select>
            </div>
            <div class="col-md-2"> </div>
            <div class="col-md-2  d-flex align-items-center">
              @*   <button type="button" class="btn bg-d common_btn1 txt-white" data-bs-toggle="modal" data-bs-target="#myModal"> *@
                <button type="button" class="btn btnModel " style="width:auto; height:40px" data-bs-toggle="modal" data-bs-target="#myModal">
                    <i class="bi bi-plus"></i> Add Product
                </button>
            </div>
        </div>
    </div>
    <div class="filter-panel mt-2">
        <table id="myTable" class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Sr.No</th>
                    <th>Main Category Name</th>
                    <th>Brand Name</th>
                    <th>Product Name</th>
                    <th>Model No.</th>
                    <th>Price</th>
                    <th>G.Total</th>
                    <th>New GST <br> G.Total</th>
                    <th style="width:400px">Specifications</th>
                    <th>Tender Details</th>
                    <th>Active Status</th>
                    <th>Update Edit</th>



                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="tfoot bg-primary">
            </tfoot>
        </table>
    </div>
</div>

