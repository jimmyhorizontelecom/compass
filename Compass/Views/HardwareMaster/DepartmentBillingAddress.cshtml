@using System.Security.Claims
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var roleId = User.FindFirst("RoleId")?.Value;
    var userId = User.FindFirst("UserId")?.Value;
    var deptId = User.FindFirst("DeptId")?.Value;
}
@{
    Layout = "~/Views/Shared/_TestLayout.cshtml";
}

<div class="container">
    <div class="filter-panel mt-5">
        <div class="row">
            <div class="col-md-8"></div>
            <div class="col-md-4">
                <button type="button" class="btn bg-d common_btn1 txt-white" data-bs-toggle="modal" data-bs-target="#myModal">
                    Add Billing Address
                </button>

            </div>
        </div>
    </div>
</div>

@section Modals {
    <!-- Product Modal -->
    <div class="modal" id="myModal">
        <div class="modal-dialog modal-md">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel">Add Billing Address</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body">
                    <div class="form-group row">
                        <div class="col-md-6 ">
                            <label class="form-label">Department Name<span class="text-danger">*</span></label>
                            <select id="ddlDepartment" class="form-select search_ddl select2" aria-label=".form-select-sm">
                                @*  <select id="ddlDepartment" class="form-select form-select-sm" aria-label=".form-select-sm">
                                <option value="0" selected> select </option> *@

                            </select>
                            <span class="error"></span>
                        </div>
                        <div class="col-md-6 ">
                            <label class="form-label">District Name<span class="text-danger">*</span></label>
                            <select id="ddlDistrict" class="form-select search_ddl select2" aria-label=".form-select-sm">
                                @* <select id="ddlDistrict" class="form-select form-select-sm" aria-label=".form-select-sm">
                                <option value="0" selected> District </option> *@

                            </select>
                            <span class="error"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-md-12 ">
                            <label class="form-label mb-0">Nodal Officer Name<span class="text-danger">*</span></label>
                            <input type="text" id="txtNodal" class="form-control txtbx mt-0 cleartxt" placeholder="Nodal Person Name" />
                            <span class="error"></span>
                        </div>

                    </div>
                    <div class="form-group row">
                        <div class="col-md-6 ">
                            <label class="form-label mb-0">Office Email<span class="text-danger">*</span></label>
                            <input type="text" id="txtEmail" class="form-control txtbx mt-0 cleartxt" placeholder="Email" />
                            <span class="error"></span>
                        </div>
                        <div class="col-md-6 ">
                            <label class="form-label mb-0">Contact No.<span class="text-danger">*</span></label>
                            <input type="text" id="txtContactNo" class="form-control  numericOnly txtbx mt-0 cleartxt" placeholder="Contact No." />
                            <span class="error"></span>
                        </div>



                    </div>
                    <div class="form-group row">
                        <div class="col-md-12 ">
                            <label for="remark" class="form-label">Billing Address</label>
                            <textarea class="form-control" id="txtArea" rows="3" placeholder="Please Enter Address Here"></textarea>
                            <span class="error"></span>
                        </div>

                    </div>
                    <div class="form-group row">


                        <div class="col-md-6 mb-3">

                            <div class="form-check">

                                <label class="form-check-label" for="flexRadioDefault1">
                                    Is Active
                                </label>
                                <input class="form-check-input" type="checkbox" name="IsActive" id="Checkbox" checked>

                            </div>

                            <span class="error"></span>
                        </div>
                    </div>


                </div>

                <!-- Modal footer -->
                <div class="modal-footer  bg-ld ">
                    <div class="me-auto">
                        <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                    </div>
                    <div class="flex-grow-1 text-center modelalert text-danger"></div>
                    <button type="button" class="btn btnModel btnModalSubmit">Submit</button>
                </div>

            </div>
        </div>
    </div>
    <div class="container mt-5">
        <h2 class="mb-4">Add Billing Address</h2>

        <table id="myTable" class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Sr.No</th>
                    <th>Department Name</th>
                    <th>District</th>
                    <th>Billing Address</th>
                    <th>Nodal Officer Name</th>
                    <th>Email</th>
                    <th>Contact No.</th>
                    <th>Edit</th>




                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="tfoot bg-primary">
            </tfoot>
        </table>
    </div>
}


@section Scripts {
    <script src="~/PageAssets/Hardware/Js/HardwareMaster/DepartmentBillingAddress.js" asp-append-version="true"></script>
}
