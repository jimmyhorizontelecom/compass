<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-3">

    <div class="mb-2">
        <button id="btnDownloadFormat" class="btn btn-info">
            Download Excel Format
        </button>

        <input type="file" id="excelFile" class="form-control mt-2" />

        <button id="btnUpload" class="btn btn-primary mt-2">
            Upload
        </button>

        <button id="btnVerify" class="btn btn-success mt-2">
            Verify
        </button>
    </div>
    <table class="table table-bordered mt-3" id="tblData">
        <thead>
            <tr>
                <th>Roll No</th>
                <th>Name</th>
                <th>Mobile</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

</div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>

    $("#btnUpload").click(function () {

    var file = $("#excelFile")[0].files[0];

    if (!file) {
    alert("Please select an Excel file.");
    return;
    }

    var formData = new FormData();
    formData.append("file", file);

    $.ajax({
    url: '/HardwareReport/ReadExcel',
    type: 'POST',
    data: formData,
    contentType: false,
    processData: false,

    success: function (response) {

    console.log(response);

    $("#tblData tbody").empty();

    $.each(response, function (index, item) {

    var row = `
    <tr>
    <<td>${item.RollNo}</td>
    <td>${item.Name}</td>
    <td>${item.Mobile}</td>
    <td class="status"></td>
    </tr>`;

    $("#tblData tbody").append(row);
    });
    },

    error: function () {
    alert("Error reading Excel file.");
    }
    });

    });
    $("#btnDownloadFormat").click(function () {

    window.location.href =
    "/HardwareReport/DownloadFormat";

    });

</script>
