    <style>
            .invoice-box {
                width: 210mm;
                margin: auto;
                background: #fff;
            }

            .a4-page {
                width: 210mm;
                min-height: 297mm;
                padding: 5mm;
                box-sizing: border-box;
                page-break-after: always;
                background: white;
            }

                .a4-page:last-child {
                    page-break-after: auto;
                }

            .logo {
                height: 70px;
            }

            @@media print {

                .no-print {
                    display: none !important;
                }

                @@page {
                    size: A4;
                    margin: 5mm;
                }

                .a4-page {
                    page-break-after: always;
                }

                tr {
                    page-break-inside: avoid !important;
                }

                table {
                    width: 100%;
                    border-collapse: collapse;
                }
            }
