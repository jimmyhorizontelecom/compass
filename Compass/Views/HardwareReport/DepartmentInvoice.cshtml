</head>
<body>

    <div class="container mt-3 no-print">
        <button class="btn btn-primary" onclick="printInvoice()">Print</button>
        <button class="btn btn-success" onclick="downloadPDF()">Download PDF</button>
    </div>

    <div class="invoice-box" id="invoiceArea">
        <div class="page-header">
            <span class="page-number"></span>
        </div>
        <!-- HEADER -->
        @*   <div class="d-flex justify-content-between">
            <img src="~/assets/images/logo.png" class="logo" />
            <div class="text-end">
                <h4>Invoice</h4>
                <p>
                    No: <span id="invoiceNo"></span><br>
                    Date: <span id="invoiceDate"></span>
                </p>
            </div>
        </div> *@
        <div style="display:flex;align-items:center; border-style:solid; padding:5px">
            <div>
                <img style="width: 115px; " src="~/assets/images/picture1.png" />
            </div>
            <div style="flex:1; text-align:center; line-height:1">
                <h6 class="text-center" style="margin:0">
                    Himachal Pradesh State Electronics Development Corporation Limited <br />IT BHAWAN,1st FLOOR,Beolia Road, Mehli Shimla 171013 H.P.
                </h6>
                <h6 class="text-center" style="margin:0">
                    GSTIN/UIN:02AAACH3904P2ZO <br />State Name: Himachal Pradesh, Code:02<br />Email: manpower@hpsedc.in
                </h6>
            </div>
        </div>
        <div style="padding:3px; border-style:solid; border-top:0px">
            <span>IRN No:- </span><br />
            <div style="display:flex">
                <span style="width: 300px;">
                    Ack Date: @Model.AckDt.ToString("dd/MM/yyyy")
                    @*  Ack Date: @(Model?.AckDt.ToString("dd/MM/yyyy")) *@
                </span>
                <span style="width: 300px;">
                    Ack No: @Model.AcKNo
                </span>
                <span style="width: 400px;">
                    GST No: @Model.gstNo
                </span>
            </div>
        </div>
        <div style="display:flex; border-style:solid; border-top:0px">
            <div style="width:60%">
                <span>Consignee(Ship to)</span><br />
                <span>
                    @Model.departmentName <br />
                    @(Model?.AgencyName ?? "") <br />
                </span>
            </div>
            <div style="width:40%; border-left:2px solid black">
                <div style="padding:5px">
                    <span>Date:@Model.BillDate.ToString("dd/MM/yyyy")</span>
                </div>
                <div style="padding:5px; border-top:2px solid black">
                    <span>
                        HPSEDC Invoice & WO.Ref No.
                        <br>
                        @Model.SaleBillNo <br />@Model.WorkOrderNo
                    </span>
                </div>
            </div>
        </div>
        <div style="display:flex; border-style:solid; border-top:0px">
            <div style="width:60%">
                <span>Buyer (Bill to)</span><br />
                <span>
                    @Model.departmentName <br />
                    @Model.DepartmentAddress <br />
                </span>
            </div>
            <div style="width:40%;border-left:2px solid black">
                <div style="padding:5px">
                    <span>
                        Agency Invoice Ref. No.:<br>
                        @Model.fvBillNo
                    </span>
                </div>
                <div style="padding:5px; border-top:2px solid black">
                    <span>Date:@Model.PurchaseBillDate.ToString("dd//yyyy")</span>
                </div>
            </div>
        </div>
        <div style="border-style:solid; border-top:0px">
            <table class="table table-bordered" style="text-align:center;">
                <thead>
                    <tr>
                        <th>Sr. No</th>
                        <th>Description</th>
                        <th>No. Of Res.</th>
                        <th>Rate</th>
                        <th>Per</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>@Model.Description</td>
                        <td>@Model.NoOfResource</td>
                        <td></td>
                        <td></td>
                        <td>@Model.AgencyBillAmt</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Administrative Charge</td>
                        <td></td>
                        <td>5</td>
                        <td>%</td>
                        <td>@Model.HpsedcCharges</td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>Output CGST</td>
                        <td></td>
                        <td>9</td>
                        <td>%</td>
                        <td>@Model.AgencyBillAmtCgst</td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>Output SGST</td>
                        <td></td>
                        <td>9</td>
                        <td>%</td>
                        <td>@Model.AgencyBillAmtSgst</td>
                    </tr>
                </tbody>
                <tfoot class="tfoot">
                    <tr>
                        <td colspan="2"><strong>Total</strong></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td><strong>@Model.GrandBillAmount</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div style="border-style:solid; border-top:0; margin:0;">
            <strong> Amount Chargeable (In Words)</strong> @Model.GrandBillAmountWord <br />
        </div>
        <div style="border-style:solid; border-top:0; margin:0;">
            <table class="table table-bordered" style="text-align:center; ">
                <thead>
                    <tr>
                        <th rowspan="2" style="vertical-align:middle;">HSN/SAC</th>
                        <th rowspan="2" style="vertical-align:middle;">Taxable Value</th>
                        <!-- Central Tax split into 2 columns -->
                        <th colspan="2">Central Tax</th>
                        <!-- State Tax split into 2 columns -->
                        <th colspan="2">State Tax</th>
                        <th rowspan="2" style="vertical-align:middle;">Total Tax Amount</th>
                    </tr>
                    <tr>
                        <th>Rate</th>
                        <th>Amount</th>
                        <th>Rate</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                   @*  <tr>
                        <td>@Model.HSN</td>
                        <td>@Model.tax</td>
                        <td>9%</td>
                        <td>@Model.CGSTAmount</td>
                        <td>9%</td>
                        <td>@Model.SGSTAmount</td>
                        <td>@Model.GSTAmount</td>
                    </tr> *@

                    <tr>
                        <td>998513</td>
                        <td>@Model.AgencyBillAmt</td>
                        <td>9%</td>
                        <td>@Model.AgencyBillAmtCgst</td>
                        <td>9%</td>
                        <td>@Model.AgencyBillAmtSgst</td>
                        <td>@Model.BaseGSTTotal</td>
                    </tr>
                    <tr>
                        <td>998519</td>
                        <td>@Model.HpsedcCharges</td>
                        <td>9%</td>
                        <td>@Model.AdminAmtCgst</td>
                        <td>9%</td>
                        <td>@Model.AdminAmtSgst</td>
                        <td>@Model.AdminGSTTotal</td>
                    </tr>
                </tbody>
                <tfoot class="tfoot">
                    <tr>
                        <td><strong>Total</strong></td>
                        <td>@Model.tax</td>
                        <td></td>
                        <td>@Model.CGSTAmount</td>
                        <td></td>
                        <td>@Model.CGSTAmount</td>
                        <td><strong>@Model.GSTAmount</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div style="display:flex; border-style:solid; border-top:0px">
            <div style="width:50%; padding:5px 5px 0px 5px;">
                <span><strong> Amount (In Words)</strong></span><br />
                @Model.TaxableamttotalWord <br />
                <span><strong>Remarks:</strong></span><br /> @Model.Narration
                <div><strong>Declaration:</strong></div>
                <div style="line-height:1">
                    We declare that this invoice shows the actual cost of manpower deployed and
                    that all particulars are true and correct.
                </div>
                <div style="line-height:1;">
                    <h6 style="margin:0;">HPSEDC VAT TIN : 02010300179</h6>
                    <h6 style="margin:0;">HPSEDC CST No.   : CST-CSI-2831</h6>
                    <h6 style="margin:0;">HPSEDC PAN         : AAACH3904P</h6>
                </div>
            </div>
            <div style="width:50%; border-left:2px solid black">
                <div style="padding:5px ; ">
                    <span> <strong> Bank : </strong> IDBI Bank LTD</span><br>
                    <span> <strong> Branch Name :  </strong> Mehli Shimla, Himachal Pradesh  </span><br>
                    <span> <strong> Account Name :  </strong>  MD HP STATE ELECTRONICS DEV CO LTD </span><br>
                    <span> <strong> Account No. :  </strong>  1481102000000374 </span><br>
                    <span> <strong> IFSC Code :  </strong>  IBKL0001481 </span><br>
                </div>
                <div style="margin-top:30px;">
                    <span><strong>Prepared By</strong></span>
                    <span style="margin-left:20px;"><strong>Verified By</strong></span>
                    <span style="margin-left:20px;"><strong>Authorised Signatory</strong></span>
                </div>
            </div>
        </div>
        @*   <!--Page Break-->
        <div style="page-break-after: always;">
            <!-- Next content goes to new page -->
        </div> *@
        <!-- Letter -->
        <div class="container-fluid">
            <div style="display:flex">
                <div style="width:30%">
                    <h6> HIMACHAL PRADESH STATE ELECTRONICS DEVELOPMENT CORPORATION LIMITED</h6>
                </div>
                <div style="width:20%; margin-top:20px; padding:5px">
                    <img style="width: 125px; " src="~/assets/images/picture1.png" />
                </div>
                <div style="width:50%">
                    <h6>
                        IT Bhawan, Ground & 1st Floor Beolia Road, Mehli Shimla, H.P. -171013 <br />
                        Ph. 0177-2623513, 2628473,<br />
                        GSTIN/UIN: 02AAACH3904P2ZO <br />
                        State Name : Himachal Pradesh, Code : 02<br />
                        E-Mail : hpsedc@hpsedc.in
                    </h6>
                </div>
            </div>
            <div style="display:flex">
                <div style="width:50%">
                    <h5>@Model.SaleBillNo</h5>
