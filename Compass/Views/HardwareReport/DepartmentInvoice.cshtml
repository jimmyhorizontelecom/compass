@using Compass.Report.ViewModels
@model DeptInvoiceReportVM
@{
    Layout = null;
}
@if (Model == null)
{
    <h3>No Data Found</h3>
    return;
}

<html>
<head>
    <title>Department Invoice</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    @* <style>
            .invoice-box {
                width: 210mm;
                min-height: 297mm;
                margin: auto;
