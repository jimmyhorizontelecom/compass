@using Compass.Report.ViewModels
@model DeptInvoiceReportVM
<h2 class="text-center">Tax Invoice</h2>
<div class="d-flex justify-content-end mb-2 no-print">
    <button onclick="window.print()" class="btn btn-primary">
        🖨 Print Invoice
    </button>
</div>

<!-- Tax Invoice -->
<div class="container-fluid">
    
    <div style="display:flex;align-items:center; border-style:solid; padding:5px">
        <div>
        <img style="width: 115px; " src="~/assets/images/picture1.png" />
        </div>
        <div style="flex:1; text-align:center">
        <h5 class="text-center">
            Himachal Pradesh State Electronics Development Corporation Limited <br />IT BHAWAN,1st FLOOR,Beolia Road, Mehli Shimla 171013 H.P.
        </h5>
        <h6 class="text-center">
            GSTIN/UIN:02AAACH3904P2ZO <br />State Name: Himachal Pradesh, Code:02<br />Email: manpower@hpsedc.in
        </h6>
        </div>
    </div>
    <div style="padding:10px; border-style:solid; border-top:0px">
        <span>IRN No:- </span><br />
        <div style="display:flex">
            <span style="width: 300px;">
                Ack Date: @Model.AckDt.ToString("dd/MM/yyyy")
            </span>

            <span style="width: 400px;">
                Ack No: @Model.AcKNo
            </span>

            <span>
                GST No: @Model.gstNo
            </span>
        </div>
    </div>
    <div style="display:flex; border-style:solid; border-top:0px">
        <div style="width:75%">
            <span>Consignee(Ship to)</span><br />
            <span>
                @Model.departmentName <br />
                @Model.DepartmentAddress <br />
               
            </span>
        </div>
        <div style="width:25%; border-left:2px solid black">
            <div style="padding:5px">
                <span>Date:@Model.BillDate.ToString("dd/MM/yyyy")</span>
            </div>
            <div style="padding:5px; border-top:2px solid black">
                <span>
                    HPSEDC Invoice & WO.Ref No.
                <br>
                @Model.SaleBillNo <br />@Model.WorkOrderNo
                </span>
            </div>
            
        </div>
    </div>
    <div style="display:flex; border-style:solid; border-top:0px">
        <div style="width:75%">
            <span>Buyer (Bill to)</span><br />
            <span>
                @Model.departmentName <br />
                @Model.DepartmentAddress <br />
            </span>
        </div>
        <div style="width:25%;border-left:2px solid black">
            <div style="padding:5px">
                <span>
                    Agency Invoice Ref. No.:<br>
                    @Model.fvBillNo
                </span>
            </div>
            <div style="padding:5px; border-top:2px solid black">
                <span>Date:@Model.PurchaseBillDate.ToString("dd//yyyy")</span>
            </div>
            
        </div>
    </div>
    <div style="border-style:solid; border-top:0px">
        <table class="table table-bordered" style="text-align:center;">
            <thead>
                <tr>
                    <th>Sr. No</th>
                    <th>Description</th>
                    <th>No. Of Res.</th>
                    <th>Rate</th>
                    <th>Per</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>@Model.Description</td>
                    <td>@Model.NoOfResource</td>
                    <td></td>
                    <td></td>
                    <td>@Model.BaseTotal</td>
                </tr>
                <tr>                    
                    <td>2</td>
                    <td>Administrative Charge</td>
                    <td></td>
                    <td>5</td>
                    <td>%</td>
                    <td>@Model.HpsedcCharges</td>
                </tr>
                <tr>                    
                    <td>3</td>
                    <td>Output CGST</td>
                    <td></td>
                    <td>9</td>
                    <td>%</td>
                    <td>@Model.AdminAmtCgst</td>
                </tr>
                <tr>
                    <td>4</td>
                    <td>Output SGST</td>
                    <td></td>
                    <td>9</td>
                    <td>%</td>
                    <td>@Model.AdminAmtSgst</td>
                </tr>

            </tbody>
            <tfoot class="tfoot">
                <tr>
                    
                    <td colspan="2"><strong>Total</strong></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td><strong>@Model.Taxableamttotal</strong></td>
                    
                </tr>
            </tfoot>
        </table>
    </div>
    <div style="border-style:solid; border-top:0; margin:0;">
        <strong> Amount Chargeable (In Words)</strong> @Model.TaxableamttotalWord <br />
        
       
    </div>
    <div style="border-style:solid; border-top:0; margin:0;">
        <table class="table table-bordered" style="text-align:center; ">
            <thead>
                <tr>
                    <th rowspan="2" style="vertical-align:middle;">HSN/SAC</th>
                    <th rowspan="2" style="vertical-align:middle;">Taxable Value</th>
                    <!-- Central Tax split into 2 columns -->
                    <th colspan="2">Central Tax</th>
                    <!-- State Tax split into 2 columns -->
                    <th colspan="2">State Tax</th>
                    <th rowspan="2" style="vertical-align:middle;">Total Tax Amount</th>
                </tr>
                <tr>
                    <th>Rate</th>
                    <th>Amount</th>
                    <th>Rate</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>998513</td>
                    <td>@Model.Taxableamttotal</td>
                    <td>9%</td>
                    <td>@Model.CGSTAmount</td>
                    <td>9%</td>
                    <td>@Model.SGSTAmount</td>
                    <td>@Model.BillAmount</td> 
                </tr>

                <tr>
                    <td>998519</td>
                    <td>@Model.Taxableamttotal</td>
                    <td>9%</td>
                    <td>@Model.CGSTAmount</td>
                    <td>9%</td>
                    <td>@Model.SGSTAmount</td>
                    <td>@Model.BillAmount</td>
                </tr>
            </tbody>
            <tfoot class="tfoot">
                <tr>
                    
                    <td ><strong>Total</strong></td>
                    <td ><strong>Total</strong></td>
                    <td ></td>
                    <td ><strong>Total</strong></td>
                    <td ></td>
                    <td ><strong>Total</strong></td>
                    <td><strong>@Model.GrandBillAmount</strong></td>
                    
                </tr>
            </tfoot>
        </table>
    </div>
    <div style="display:flex; border-style:solid; border-top:0px">
        <div style="width:55%">
            <span><strong> Amount (In Words)</strong></span><br />
            @Model.GrandBillAmountWord <br />
            <span><strong>Remarks:</strong></span><br /> @Model.Narration
        </div>
        <div style="width:45%; border-left:2px solid black">
            <div style="padding:5px">
                <span> <strong> Bank : </strong> IDBI Bank LTD</span><br>
                <span> <strong> Branch Name :  </strong> Mehli Shimla, Himachal Pradesh  </span><br>
                <span> <strong> Account Name :  </strong>  MD HP STATE ELECTRONICS DEV CO LTD </span><br>
                <span> <strong> Account No. :  </strong>  1481102000000374 </span><br>
                <span> <strong> IFSC Code :  </strong>  IBKL0001481 </span><br>
                
            </div>
            
        </div>
    </div>
    <div style="display:flex; border-style:solid; border-top:0px">
        <div style="width:50%">
            <span><strong>Declaration:</strong></span><br />
            <span>
                We declare that this invoice shows the
                actual cost of manpower deployed and
                that all particulars are true and correct.
            </span><br />
        </div>
        @*  <div style="width:50%; border-left:2px solid black; display:flex; align-items:flex-end;">
            <div style="padding:5px ;">
                <span style="margin-left:50px"> <strong> Prepared By </strong> </span>
                <span style="margin-left:150px"> <strong> Verified By </strong> </span>
                <span style="margin-left:150px"> <strong> Authorised Signatory </strong></span>
            </div>
        </div> *@
        <div style="width:50%; border-left:2px solid black;  position:relative;">
    
            <div style="position:absolute; bottom:5px; width:100%; padding:5px; display:flex; justify-content:space-between;">
                <span><strong>Prepared By</strong></span>
                <span><strong>Verified By</strong></span><span><strong>Authorised Signatory</strong></span>
            </div>

        </div>
    </div>
    <div style="border-style:solid; border-top:0; margin:0;text-align:center">
        <span>This is a Compass System Generated Bill.</span>
    </div>

</div>

            
<div style="page-break-after: always;">
    <!-- Next content goes to new page -->
</div>

