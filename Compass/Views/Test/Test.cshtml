@{
    Layout = null;
}

<html>
<head>
    <title>Invoice</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        .invoice-box {
            width: 210mm;
            min-height: 297mm;
            margin: auto;
            padding: 20px;
            background: #fff;
        }

        .logo {
            height: 70px;
        }

        @@media print {

            @@page {
                size: A4;
                margin: 20mm;
            }

            body {
                counter-reset: page;
            }

            .page-number:before {
                content: "Page " counter(page);
            }

            .page-header {
                position: fixed;
                top: 0;
                right: 20px;
                font-size: 12px;
            }

            #invoiceArea {
                width: 800px; /* fixed width helps jsPDF */
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            tr {
                page-break-inside: avoid;
            }

            .invoice-box {
                page-break-after: auto;
            }
        }
    </style>
</head>
<body>

    <div class="container mt-3 no-print">
        <button class="btn btn-primary" onclick="printInvoice()">Print</button>
        <button class="btn btn-success" onclick="downloadPDF()">Download PDF</button>
    </div>

    <div class="invoice-box" id="invoiceArea">
        <div class="page-header">
            <span class="page-number"></span>
        </div>
        <!-- HEADER -->
        <div class="d-flex justify-content-between">
            <img src="~/assets/images/logo.png" class="logo" />
            <div class="text-end">
                <h4>Invoice</h4>
                <p>
                    No: <span id="invoiceNo"></span><br>
                    Date: <span id="invoiceDate"></span>
                </p>
            </div>
        </div>

        <!-- CUSTOMER -->
        <div class="mt-3">
            <strong>Customer:</strong>
            <p id="customerName"></p>
        </div>

        <!-- TABLE -->
        <table class="table table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Item</th>
                    <th>Qty</th>
                    <th>Price</th>
                    <th>GST</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody id="invoiceTable"></tbody>
        </table>

        <!-- TOTAL -->
        <div class="text-end">
            <h5>Grand Total: ₹ <span id="grandTotal"></span></h5>
        </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <!-- jsPDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
                $(document).ready(function () {
            loadInvoice();
        });

                function loadInvoice() {
                 
            $.ajax({
                url: '/HardwarePurchase/GetInvoiceData',
                type: 'GET',
                success: function (res) {

                    $('#invoiceNo').text(res.invoiceNo);
                    $('#invoiceDate').text(res.date);
                    $('#customerName').text(res.customer);

                    let total = 0;
                    let rows = '';

                    $.each(res.items, function (i, item) {

                        let baseAmount = item.qty * item.price;

                        let gstPercent = (item.CGST || 0) + (item.SGST || 0);
                        let gst = baseAmount * gstPercent / 100;

                        let rowTotal = baseAmount + gst;

                        total += rowTotal;

                        rows += `<tr>
                            <td>${i + 1}</td>
                            <td>${item.name}</td>
                            <td>${item.qty}</td>
                            <td>₹ ${item.price}</td>
                            <td>₹ ${gst.toFixed(2)}</td>
                            <td>₹ ${rowTotal.toFixed(2)}</td>
                        </tr>`;
                    });

                    $('#invoiceTable').html(rows);
                    $('#grandTotal').text("₹ " + total.toFixed(2));
                }
            });
        }
                function printInvoice() {
            window.print();
        }
                  function downloadPDF() {

            const { jsPDF } = window.jspdf;

            let doc = new jsPDF('p', 'mm', 'a4');

            let content = document.getElementById("invoiceArea");

            doc.html(content, {
                callback: function (doc) {

                    let pageCount = doc.internal.getNumberOfPages();

                    for (let i = 1; i <= pageCount; i++) {
                        doc.setPage(i);
                        doc.setFontSize(10);

                        // Page number at TOP
                        doc.text("Page " + i + " of " + pageCount, 170, 10);
                    }

                    doc.save("Invoice.pdf");
                },

                x: 5,
                y: 10,
                width: 200,   // VERY IMPORTANT (fit A4 width)

                windowWidth: 1000, // helps scaling

                html2canvas: {
                    scale: 0.5,   // reduce size to fit page
                    useCORS: true
                },

                autoPaging: 'text'  // 🔥 THIS FIXES CUTTING ISSUE
            });
        }
    </script>
</body>
</html>
