@using System.Security.Claims
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var roleId = User.FindFirst("RoleId")?.Value;
    var userId = User.FindFirst("UserId")?.Value;
    var deptId = User.FindFirst("DeptId")?.Value;
}
@{
    Layout = "~/Views/Shared/_TestLayout.cshtml";
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
}
<!-- Buttons -->
<div class="card mb-4 p-3">
    <div class="row align-items-end">
        <div class="form-group row">
            <!-- Buttons -->
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-primary btn-sm" onclick="showDiv('newSaleDiv')">
                    ➕ New Sale Order
                </button>

                <button class="btn btn-success btn-sm" onclick="showDiv('listDiv')">
                    📋 Sale Order List
                </button>

            </div>
            <div class="col-md-2 ">
                <label class="form-label">Department Name Filter<span class="text-danger">*</span></label>
                <select id="ddlDepartment" class="form-select search_ddl select2" aria-label=".form-select-sm">
                </select>
                <span class="error"></span>
            </div>
            <div class="col-md-2 ">
                <label class="form-label">Agency Name Filter<span class="text-danger">*</span></label>
                <select id="ddlAgency" class="form-select search_ddl select2" aria-label=".form-select-sm">
                </select>
                <span class="error"></span>
            </div>

        </div>

       
       
    </div>
</div>


<!-- New Sale Div -->
<div id="newSaleDiv" class="card p-3 shadow">
    <div class="form-group row">
        <div class="col-md-2 ">
            <label class="form-label">Department <span class="text-danger">*</span></label>
            <select id="ddlDept" class="form-select search_ddl select2" aria-label=".form-select-sm">
            </select>
           @*  <span class="error"></span> *@
        </div>
        <div class="col-md-2 ">
            <label class="form-label">Billing Address <span class="text-danger">*</span></label>
            <select id="ddlBilling" class="form-select search_ddl select2" aria-label=".form-select-sm">
            </select>
           @*  <span class="error"></span> *@
        </div>
        <div class="col-md-2 text-sm-start">
            <label class="form-label-sm mb-0">Reference<span class="text-danger">*</span></label>
            <input type="text" id="txtReference" class="form-control txtbx mt-0 " placeholder="Reference" />
           @*  <span class="error"></span> *@
        </div>
        <div class="col-md-2 text-sm-start">
            <label for="deptOrderDate" class="form-label fw-semibold">  Dept Order Date <span class="text-danger">*</span> </label>
            <input type="date"  id="deptOrderDate"   class="form-control"  max="" required />
           @*  <span class="text-danger small" id="deptDateError"></span> *@
        </div>
        <div class="col-md-2 text-sm-start">
            <label for="orderEntryDate" class="form-label fw-semibold"> Order Entry Date <span class="text-danger">*</span></label>
            <input type="date" id="orderEntryDate" class="form-control" readonly />
            @* <span class="text-danger small" id="entryDateError"></span> *@
        </div>
        <div class="col-md-2">
            <div class="form-check">
                <label class="form-check-label" for="flexRadioDefault1"> Is Payment Required? </label>
                <input class="form-check-input" type="checkbox" name="IsActive" id="IsActive" checked>
            </div>
        </div>

    </div>
    <div class="card text-center">
        <div class="card-header bg-cream text-dark fw-bold" style="background-color: #FAF3E0;">
            Add Sale Item Details
        </div>
        <div class="card-body">
            <div class="form-group row mb-0">
                <div class="col-md-2 text-sm-start">
                    <label class="col-form-label-sm mb-0">Main Category <span class="text-danger">*</span></label>
                    <select id="ddlMainCatg" class="form-select search_ddl select2 cleartxt" aria-label=".form-select-sm">
                    </select>
                   @*  <span class="error"></span> *@
                </div>
                <div class="col-md-2 text-sm-start">
                    <label class="form-label-sm mb-0">Brand <span class="text-danger">*</span></label>
                    <select id="ddlBrand" class="form-select search_ddl select2 cleartxt">
                    </select>
                </div>
                <div class="col-md-2 text-sm-start">
                    <label class="form-label-sm mb-0">Product Category <span class="text-danger">*</span></label>
                    <select id="ddlProductCatg" class="form-select search_ddl select2 cleartxt">
                    </select>
                </div>
                <div class="col-md-2 text-sm-start">
                    <label class="form-label-sm mb-0">Item Name With Model <span class="text-danger">*</span></label>
                    <select id="ddlItemName" class="form-select search_ddl select2 cleartxt">
                    </select>
                </div>
                <div class="col-md-2 text-sm-start">
                    <label class="form-label-sm mb-0">Quantity<span class="text-danger">*</span></label>
                    <input type="text" id="Quantity" class="form-control numericOnly txtbx mt-0 cleartxt" placeholder="Quantity" />
                    @* <span class="error"></span> *@
                </div>
                <div class="col-md-2 text-sm-start">
                    <label class="form-label-sm mb-0">Naration<span class="text-danger">*</span></label>
                    <input type="text" id="Naration" class="form-control txtbx mt-0 cleartxt" placeholder="Naration" />
                  @*   <span class="error"></span> *@
                </div>
            </div>
            <div class="form-group row">
                <div class="col-md-2 text-sm-start">
                    <label class="form-label form-label-sm mb-0">Rate<span class="text-danger">*</span></label>
                    <input type="text" id="Rate" readonly class="form-control form-control-sm  numericOnly  decimalOnly txtbx mt-0 cleartxt" placeholder="Rate" />
                   
                </div>
                <div class="col-md-2 text-sm-start">
                    <label class="form-label-sm mb-0">Total Rate<span class="text-danger">*</span></label>
                    <input type="text" id="TotalRate" readonly class="form-control numericOnly decimalOnly txtbx mt-0 cleartxt" placeholder="Total Rate" />
                    
                </div>
                <div class="col-md-2 text-sm-start">
                    <label class="form-label-sm mb-0">Admin Charge<span class="text-danger">*</span></label>
                    <input type="text" id="AdminCharge" readonly class="form-control numericOnly txtbx mt-0 cleartxt" placeholder="Admin Charge" />
                   
                </div>
                <div class="col-md-2 text-sm-start">
                    <label class="form-label-sm mb-0">GST<span class="text-danger">*</span></label>
                    <input type="text" id="GST" readonly class="form-control numericOnly txtbx mt-0 cleartxt" placeholder="GST" />
                   
                </div>
                <div class="col-md-2 text-sm-start">
                    <label class="form-label-sm mb-0">Total<span class="text-danger">*</span></label>
                    <input type="text" id="Total" readonly class="form-control numericOnly decimalOnly txtbx mt-0 cleartxt" placeholder="Total" />
                   
                </div>
                <div class="col-md-2 text-sm-start">
                    <label for="remark" class="form-label">Specification</label>
                    <textarea class="form-control cleartxt" id="Specification" rows="3" placeholder="Enter Specification Here"></textarea>
                   
                </div>
                <div class="text-center">
                    <button type="button" id="btnAdd" class="btn btn-primary btn-sm">
                        Add Detail
                    </button>
                </div>

            </div>

        </div>
        <div class=" text-muted">
        </div>
    </div>
    <!-- Sale Item List -->

    <div id="SaleItem" class="card p-3 shadow">
        <h5>Sale Item List</h5>
        <table id="myTable1" class="table table-bordered border-primary">
            <thead class="table-info">
                <tr>
                    <th>Sr.No</th>
                    <th>Main Category</th>
                    <th>Brand</th>
                    <th>Product Category</th>
                    <th>Item Name With Model</th>
                    <th>Specification</th>
                    <th>Quantity</th>
                    <th>Rate Per Price</th>
                    <th>Total Rate</th>
                    <th>Admin Charge</th>
                    <th>GST</th>
                    <th>Total</th>
                    <th>Narration</th>
                    <th>Action</th>



                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="tfoot bg-primary">
            </tfoot>
        </table>
    </div>
    <div class="form-group row">
        <div class="col-md-2">
            <div class="mb-3">
                <label for="formFileSm" class="form-label">Department Document</label>
                <input class="form-control form-control-sm" id="DeptDocument" type="file">
            </div>

            <span class="error"></span>
        </div>
        <div class="col-md-2">
            <div class="mb-3">
                <label for="formFileSm" class="form-label">Department Location Document</label>
                <input class="form-control form-control-sm" id="LocationAttachment" type="file">
            </div>
        </div>
        <div class="col-md-2">
            <div class="mb-3">
                <label class="form-label-sm mb-0">Total Price<span class="text-danger">*</span></label>
                <input type="text" id="txtPrice" class="form-control txtbx mt-0 cleartxt1" placeholder="Total Price" />
                <span class="error"></span>
            </div>
        </div>
        <div class="col-md-2">
            <div class="mb-3">
                <label class="form-label-sm mb-0">Admin Charge<span class="text-danger">*</span></label>
                <input type="text" id="txtAdminCharge" class="form-control txtbx mt-0 cleartxt1" placeholder="Admin Charge" />
                <span class="error"></span>
            </div>
        </div>
        <div class="col-md-2">
            <div class="mb-3">
                <label class="form-label-sm mb-0">GST<span class="text-danger">*</span></label>
                <input type="text" id="txtGST" class="form-control txtbx mt-0 cleartxt1" placeholder="GST" />
                <span class="error"></span>
            </div>
        </div>
        <div class="col-md-2">
            <div class="mb-3">
                <label class="form-label-sm mb-0">Grand Total<span class="text-danger">*</span></label>
                <input type="text" id="txtGTotal" class="form-control txtbx mt-0 cleartxt1" placeholder="Grand Total" />
                <span class="error"></span>
            </div>
        </div>
        <div class="text-center">
            <button type="button" id="btnsubmit" class="btn btn-primary btn-sm">
                Submit
            </button>
        </div>
    </div>
</div>



<!-- List Div -->
<div id="listDiv" class="card p-3 shadow" style="display:none;">
    <h5>Sale Order List</h5>
    <table id="myTable" class="table table-striped table-bordered">
        <thead class="table-info">
            <tr>
                <th>Sr.No</th>
                <th>Sale Order</br>Reference No.</th>
                <th>PO No.</th>
                <th>Dept.Reference No.</br>Order Date</th>
                <th>Department Name</th>
                <th>Billing Address</th>
                <th>Item Description</th>
                <th>Delivery Location Doc.</th>
                <th>Add Location</th>
                <th>Grand Total Amount</th>
                <th>Balance</th>
                <th>Dept.Received Amt.</th>
                <th>Purchase Issued</th>
                <th>Cancel Sale Order</th>
                <th>Edit</th>



            </tr>
        </thead>
        <tbody>
        </tbody>
        <tfoot class="tfoot bg-primary">
        </tfoot>
    </table>
</div>
<!-- Modal for Item description-->
@section Modals {
    <!--Model with content tab-->

    <div class="modal" id="myModalItemDescription">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel">Add Item Description</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow-x:auto;">

                    <div class="container mt-5">
                        <h2 class="mb-4">Item Description</h2>

                        <table id="myTableItemDesc" class="table table-striped table-bordered">
                            <thead class="table-info">
                                <tr>
                                    <th>Sr.No</th>
                                    <th>Item Description</th>
                                    <th>Quantity</th>
                                    <th>Base Price</th>
                                    <th>GST%</th>
                                    <th>Unit Rate(Inclusive Tax)</th>
                                    <th>Total Amt(Inclusive Tax)</th>

                                   


                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot class="tfoot bg-primary">
                            </tfoot>
                        </table>
                    </div>

                   
                  
                   
                </div>

                <!-- Modal footer -->
                <div class="modal-footer  bg-ld ">
                    <div class="me-auto">
                        <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                    </div>
                    <div class="flex-grow-1 text-center modelalert text-danger"></div>
                    @*  <button type="button" class="btn btnModel btnModalSubmit">Submit</button> *@
                    <button type="button" data-bs-dismiss="modal" class="btn btnModel">OK</button>

                </div>

            </div>
        </div>
    </div>
    <!--Modal for Add Location-->
    <div class="modal" id="myModalAddLocation">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel1">Add Product Delivery Location</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow-x:auto;">
                    <div class="card">
                        <div class="card-body">
                            <div class="form-group row mb-0">
                                <div class="col-md-4 text-sm-start">
                                    <label class="form-label-sm mb-0">Consignee Name<span class="text-danger">*</span></label>
                                    <input type="text" id="txtConsignee" class="form-control  txtbx mt-0 cleartxt" placeholder="Consignee Name" />
                                    <span class="error"></span>
                                </div>
                                <div class="col-md-4 text-sm-start">
                                    <label class="form-label-sm mb-0">Contact Number<span class="text-danger">*</span></label>
                                    <input type="text" id="txtContact" class="form-control numericOnly txtbx mt-0 cleartxt" placeholder="Contact Number" />
                                    <span class="error"></span>
                                </div>
                                <div class="col-md-4 text-sm-start">
                                    <label class="form-label-sm ">District Name<span class="text-danger">*</span></label>
                                    <select id="ddlDistrict" class="form-select search_ddl select2" aria-label=".form-select-sm">
                                    </select>
                                </div>
                            </div>
                            <div class="form-group  row mb-0">
                                <div class="col-md-4 text-sm-start">
                                    <label for="remark" class="form-label">Consignee Address</label>
                                    <textarea class="form-control cleartxt" id="txtAreaConsigneeAddr" rows="3" placeholder="EnterConsigneeAddress Here..."></textarea>
                                    <span class="error"></span>
                                </div>
                                <div class="col-md-4 text-sm-start">
                                    <label class="fw-bold d-block mb-2">Area Type</label>

                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="areaType" id="nonTribal" value="N">
                                        <label class="form-check-label" for="nonTribal">Non-Tribal Areas</label>
                                    </div>

                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="areaType" id="tribal" value="T" checked>
                                        <label class="form-check-label" for="tribal">Tribal Areas</label>
                                    </div>
                                </div>
                            </div>

                                
                            
                        </div>
                    </div>

                    <div class="container mt-5">
                        <h2 class="mb-4"></h2>

                        <table id="myTableAddLocation" class="table table-striped table-bordered">
                            <thead class="table-info">
                                <tr>

                                    <th>Sr.No</th>

                                    <th>Select All<input type="checkbox" id="selectAll"></th>
                                    <th>Item Details Id</th>
                                    <th>Product Name</th>
                                    <th>Order Qty.</th>
                                    <th>Available Quantity</th>
                                    <th>Delivery Qty.</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot class="tfoot bg-primary">
                            </tfoot>
                        </table>
                        <div class="align-content-end">
                            <button type="button" class="btn btnModel btnModalReset">Reset</button>
                            <button type="button" class="btn btnModel btnModalDeliverySubmit">Submit</button>

                        </div>

                        <div class="container mt-5">
                            <h2 class="mb-4"></h2>

                            <table id="myTableAddLocation2" class="table table-striped table-bordered">
                                <thead class="table-info">
                                    <tr>
                                        <th>Sr.No</th>
                                        <th>Product Name</th>
                                        <th>Delivery Quantity</th>
                                        <th>Consignee Name</th>
                                        <th>Contact No.</th>
                                        <th>Consignee Address</th>
                                        <th>Address Type</th>
                                        <th>Delete Address</th>




                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                <tfoot class="tfoot bg-primary">
                                </tfoot>
                            </table>
                        </div>




                    </div>

                    <!-- Modal footer -->
                    <!-- Modal footer -->
                    <div class="modal-footer  bg-ld ">
                        <div class="me-auto">
                            <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                        </div>
                        <div class="flex-grow-1 text-center modelalert text-danger"></div>
                        <button type="button" class="btn btnModel btnModalSubmit">Submit</button>
                        <button type="button" data-bs-dismiss="modal" class="btn btnModel">OK</button>

                    </div>


                </div>
            </div>
        </div>
    </div>

}



<!-- JavaScript -->
<script>

    function showDiv(divId) {
        document.getElementById("newSaleDiv").style.display = "none";
        document.getElementById("listDiv").style.display = "none";
        document.getElementById(divId).style.display = "block";
    }
</script>




@section Scripts {
    <script src="~/PageAssets/Hardware/Js/HardwareMaster/SaleOrder.js" asp-append-version="true"></script>
}