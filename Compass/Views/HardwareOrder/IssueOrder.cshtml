<style>
    div.dataTables_wrapper div.dataTables_length {
        float: left !important;
        margin-right: auto;
    }

    .star-rating i {
        font-size: 25px;
        color: #ccc;
        cursor: pointer;
    }

        .star-rating i.active {
            color: gold;
        }

    .statusGreen {
        background-color: forestgreen;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .statusOrange {
        background-color: orange;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .modal-content {
        border-radius: 0 !important;
    }
</style>





<!-- List Div -->

<div id="listDiv" class="card p-3 shadow text-center" style="display:none;">
    <h5>Sale Order</h5>
    <div class="card shadow-sm">

       
        

        <!-- Card Body -->
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-2 fw-bold">
                    <label class="form-label">Department Name Filter<span class="text-danger">*</span></label>
                    <select id="ddlDepartment" class="form-select search_ddl select2"></select>
                </div>

                <div class="col-md-2 fw-bold">
                    <label class="form-label">Agency Name Filter<span class="text-danger">*</span></label>
                    <select id="ddlAgency" class="form-select search_ddl select2"></select>
                </div>

                <div class="col-md-2 fw-bold">
                    <label class="form-label">Verification Status<span class="text-danger">*</span></label>
                    <select id="ddlVerification" class="form-select search_ddl select2"></select>
                </div>

                <div class="col-md-2 fw-bold">
                    <label class="form-label">PO Status<span class="text-danger">*</span></label>
                    <select id="ddlPOStatus" class="form-select search_ddl select2"></select>
                </div>

                <div class="col-md-2 fw-bold">
                    <label class="form-label">Dept. Amt Status<span class="text-danger">*</span></label>
                    <select id="ddlAmtStatus" class="form-select search_ddl select2"></select>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-danger w-100" id="btnExport">
                        <i class="bi bi-file-earmark-excel"></i> Export To Excel
                    </button>
                </div>

            </div>
        </div>
    </div>
    <div style="width:100%; overflow-x:auto;">
        <table id="myTableOrderIssue" class="table table-striped table-bordered">
            <thead class="table-info">
                <tr>
                    <th>Sr.No</th>
                    <th>Sale Order<br /> Reference No.</th>
                    <th>PO No.</th>
                    <th>Dept.Reff.No.<br />Order Date</th>
                    <th>Order Status</th>
                    <th>Department Name</th>
                    <th>Billing Address</th>
                    <th>Item Description</th>
                    <th>Delivery Location<br />Doc.</th>
                    <th>Bill Amount</th>
                    <th>Balance</th>
                    <th>Dept.Amt.<br />Received</th>
                    <th>PO Document</th>
                    <th>Verification Status<br />Verify Date</th>
                    <th>Action</th>
                    <th>PO Status</th>
                    <th>Remarks</th>
                    <th>Draft</th>




                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="tfoot bg-primary">
            </tfoot>
        </table>
    </div>
</div>

@section Modals {

    <!--Modal for Item Description-->
    <div class="modal" id="myModalitemDescription">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel2">Issues Purchase Order</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow-x:auto;">

                    <div class="container mt-5">
                        <h2 class="mb-4"></h2>

                        <table id="myTableItemDesc1" class="table table-striped table-bordered">
                            <thead class="table-info">
                                <tr>
                                    <th>Sr.No</th>
                                    <th>Item Description</th>
                                    <th>Quantity</th>
                                    <th>Base Price</th>
                                    <th>GST%</th>
                                    <th>Unit Rate(Inclusive Tax)</th>
                                    <th>Total Amt(Inclusive Tax)</th>




                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot class="tfoot bg-primary">
                            </tfoot>
                        </table>
                    </div>




                </div>

                <!-- Modal footer -->
                <div class="modal-footer  bg-ld ">
                    <div class="me-auto">
                        <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                    </div>
                    <div class="flex-grow-1 text-center modelalert text-danger"></div>
                    @*  <button type="button" class="btn btnModel btnModalSubmit">Submit</button> *@
                    <button type="button" data-bs-dismiss="modal" class="btn btnModel">OK</button>

                </div>

            </div>
        </div>
    </div>
    <!--Modal for Verification Status-->
    <div class="modal" id="myModalVerificationStatus">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel3">Verification Details</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow-x:auto;">
                    <div class="card-body modal-xl border border-danger border-1">
                        <!-- Remarks -->
                        <div class="form-group row">
                            <div class="d-flex align-items-center gap-3 mt-2">
                                <div class="col-md-6 ms-3">
                                    <label class="form-check-label fw-bold" for="verifyOption">Verification Status</label><br />
                                    <label class="form-check-label fw-bold" id="verityStatus" for="verifyOption">Verified</label>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-check-label fw-bold" for="verifyOption">Varification Date</label><br />
                                    <label class="form-check-label fw-bold" id="verityDate" for="verifyOption">17-Apr-2026</label>
                                </div>
                            </div>
                            <div class=" col-md-10 ms-2">
                                <label for="txtareaRemark" class="form-label fw-bold">Remarks</label>
                                <textarea class="form-control cleartxt" readonly id="txtareaVRemark" rows="2" placeholder="We may place order as per SOP on approved rates and KCC bank-50% payment recd.in portal."></textarea>
                                <span class="error"></span>
                            </div>
                        </div>

                    </div>

                </div>

                <!-- Modal footer -->
                <div class="modal-footer  bg-ld ">
                    <div class="me-auto">
                        <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                    </div>
                    <div class="flex-grow-1 text-center modelalert text-danger"></div>

                    <button type="button" data-bs-dismiss="modal" class="btn btnModel">Close</button>

                </div>

            </div>
        </div>
    </div>
    <!--Modal for Add Location-->
    <div class="modal" id="myModalPurchaseIssue">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel1">Purchase Issues Order</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow-x:auto;">
                    <div class="card">
                        <div class="card-body modal-xl border border-danger border-1">
                            <div class="form-group row">
                                <div class="col-md-4 fw-bold">
                                    <label class="form-label">Agency<span class="text-danger">*</span></label>
                                    <select id="ddlAgencyModal" class="form-select search_ddl select2"></select>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check">

                                        <label class="form-check-label" for="flexRadioDefault1">
                                            Check Box to create a single PO for selected Items
                                        </label>
                                        <input class="form-check-input" type="checkbox" name="IsActive" id="IsActive" checked>

                                    </div>
                                </div>
                            </div>



                        </div>
                    </div>

                    <div class="container mt-5">
                        <h2 class="mb-4"></h2>

                        <table id="myTablePurchaseIssue" class="table table-striped table-bordered">
                            <thead class="table-info">
                                <tr>

                                    <th>Sr.No</th>
                                    <th>Select All<input type="checkbox" id="selectAll"></th>
                                    <th>Order Detail Id</th>
                                    <th>Sale Order<br /> Refference No.</th>
                                    <th>Product Name</th>
                                    <th>Quantity</th>
                                    <th>Purchase Order No.<br />Purchase Order Date</th>
                                    <th>Amount</th>
                                    <th>Agency</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot class="tfoot bg-primary">
                            </tfoot>
                        </table>

                    </div>

                    
                    <!-- Modal footer -->
                    <div class="modal-footer  bg-ld ">
                        <div class="me-auto">
                            <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                        </div>
                        <div class="flex-grow-1 text-center modelalert text-danger"></div>
                        <button type="button" class="btn btnModel btnModalSubmit">Submit</button>
                        <button type="button" data-bs-dismiss="modal" class="btn btnModel">Close</button>

                    </div>


                </div>
            </div>
        </div>
    </div>
    <!--Modal for Purchase Order-->
    <div class="modal" id="myModalPurchaseOrder">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel">Purchase Order</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow-x:auto;">

                    <div class="container mt-5">
                        <h2 class="mb-4"></h2>

                        <table id="myTablePurchaseOrder" class="table table-striped table-bordered">
                            <thead class="table-info">
                                <tr>
                                    <th>Sr.No</th>
                                    <th>PO<br />PO Date</th>
                                    <th>Agency</th>
                                    <th>Action By Agency</th>
                                    <th>Action Date</th>
                                    <th>Action Remarks</th>

                                   



                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot class="tfoot bg-primary">
                            </tfoot>
                        </table>
                    </div>




                </div>

                <!-- Modal footer -->
                <div class="modal-footer  bg-ld ">
                    <div class="me-auto">
                        <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                    </div>
                    <div class="flex-grow-1 text-center modelalert text-danger"></div>
                    <button type="button" data-bs-dismiss="modal" class="btn btnModel">Close</button>

                </div>

            </div>
        </div>
    </div>
    <!--Modal for Purchase Order Remarks-->
    <div class="modal" id="myModalPurchaseOrderRemarks">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel1">Purchase Issues Remarks</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow-x:auto;">
                    <div class="card">
                        <div class="modal-content border border-danger border-3">
                            <div class="form-group row">
                                <div class=" col-md-6 form-check ms-6">
                                    <label for="txtareaRemark" class="form-label fw-bold">Enter Remarks</label>
                                    <textarea class="form-control cleartxt" id="txtareaRemark" rows="2" placeholder="Enter remarks"></textarea>
                                    <span class="error"></span>
                                </div>
                                <!-- File Input -->
                                <div class="col-md-4  ms-3">
                                    <label for="RemarkAttachment" class="form-label">Remark Attachment</label>
                                    <input class="form-control form-control-sm" id="RemarkAttachment" type="file">
                                    <span class="error text-danger"></span>
                                </div>
                            </div>

                                
                            <!-- Submit Button -->

                            <div class="row d-flex justify-content-md-end">
                                <div class="col-2 ">
                                    <button type="button" class="btn btn-danger  btnModalRemarkSubmit">Submit</button>
                                </div>
                            </div>

                        </div>



                    </div>
                </div>

                <div class="container mt-5">
                    <h2 class="mb-4"></h2>

                    <table id="myTablePurchaseOrderRemarks" class="table table-striped table-bordered">
                        <thead class="table-info">
                            <tr>

                                <th>Sr.No</th>
                                <th>Remarks</th>
                                <th>Remarks Doc.</th>
                                <th>Remarks Date</th>
                                <th>Remarks By</th>

                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                        <tfoot class="tfoot bg-primary">
                        </tfoot>
                    </table>

                </div>


                <!-- Modal footer -->
                <div class="modal-footer  bg-ld ">
                    <div class="me-auto">
                        <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                    </div>
                    <div class="flex-grow-1 text-center modelalert text-danger"></div>

                    <button type="button" data-bs-dismiss="modal" class="btn btnModel">Close</button>

                </div>


            </div>
        </div>
    </div>




    <!--Modal for Draft Issue-->
    <div class="modal" id="myModalDraftIssue">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel1">Create Draft</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow-x:auto;">
                    <div class="card">
                        <div class="card-body">
                            <div class="form-group row">
                                <div class="col-md-4 text-sm-start fw-bold">
                                    <label class="form-label mb-0">
                                        Agency <span class="text-danger">*</span>
                                    </label>
                                    <select id="ddlDraftAgency" class="form-select search_ddl select2">
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check text-nowrap">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="IsActive"
                                               id="IsActive"
                                               checked>

                                        <label class="form-check-label bg-warning px-2 rounded" for="IsActive">
                                            Check this Box to generate a single unique Draft No. for selected items.
                                        </label>

                                    </div>
                                </div>
                            </div>

                            

                        </div>
                    </div>

                    <div class="container mt-5">
                        <h2 class="mb-4"></h2>

                        <table id="myTableDraftIssue" class="table table-striped table-bordered">
                            <thead class="table-info">
                                <tr>

                                    <th>Sr.No</th>
                                    <th>Select All<input type="checkbox" id="selectAllPI"></th>
                                    <th>Order Details Id</th>
                                    <th>Sale Order </br>Reference No.</th>
                                    <th>Product Name</th>
                                    <th>Quantity</th>
                                    <th>Draft Order No.</br>Draft Order Date</th>
                                    <th>PO No.</br>PO Date</th>
                                    <th>Amount</th>
                                    <th>Agency</th>
                                    <th>AMC Validity</th>

                                </tr>
                            </thead>
                            <tbody>
                            </tbody>

                        </table>
                    </div>

                   

                    <!-- Modal footer -->
                    <div class="modal-footer  bg-ld ">
                        <div class="me-auto">
                            <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                        </div>
                        <div class="flex-grow-1 text-center modelalert text-danger"></div>

                        <button type="button" class="btn btnModel btnDraftSubmit">Submit</button>
                        <button type="button" data-bs-dismiss="modal" class="btn btnModel">Close</button>

                    </div>


                </div>
            </div>
        </div>
    </div>










}


