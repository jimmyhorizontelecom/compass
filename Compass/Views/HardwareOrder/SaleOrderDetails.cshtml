}
<style>


    .star-rating i {
        font-size: 25px;
        color: #ccc;
        cursor: pointer;
    }

        .star-rating i.active {
            color: gold;
        }

    .statusGreen {
        background-color: forestgreen;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .statusOrange {
        background-color: orange;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .modal-content {
        border-radius: 0 !important;
    }

    .my-modal .modal-content {
        border: 4px solid red;
    }

    .large-card-body {
        min-height: 400px;
        padding: 20px;
    }

    #txtTermConditionRemark {
        resize: vertical;
        border-radius: 10px;
        font-size: 15px;
    }

    .card-header {
        border-radius: 8px 8px 0 0;
    }

    .terms-label {
        margin-bottom: 2px;
    }

    .table td,
    .table th {
        padding: 0.35rem 0.5rem; /* Reduce row height */
        vertical-align: middle;
    }

</style>
<!-- Card Header -->
<div class="card-header bg-white border-0 text-center py-4">
    <h2 class="fw-normal text-dark">
        Sale Order Details
    </h2>
</div>
<div class="card shadow p-3">
    <div class="from-group row">
        <div class="col-md-2 fw-bold">
            <label for="txtFromDate" class="form-label">
                From Date <span class="text-danger"></span>
           </label>
            <input type="date" onchange="SaleOrderDetailList()" id="txtFromDate" class="form-control">
        </div>
        <div class="col-md-2 fw-bold">
            <label for="txtToDate" class="form-label">
                To Date <span class="text-danger"></span>
            </label>
            <input type="date" onchange="SaleOrderDetailList()" id="txtToDate" class="form-control">
        </div>
        <div class="col-md-2 fw-bold">
            <label class="form-label">PO Status</label>
            <select id="ddlPOStatus" onchange="SaleOrderDetailList()" class="form-select search_ddl select2 ">
                <option value="">All</option>
                <option value="N">Not Issued</option>
                <option value="P">Partially</option>
                <option value="Y">Issued</option>     
            </select>
        </div>
        <div class="col-md-2 fw-bold">
            <label class="form-label">Dept.Amt Status</label>
            <select id="ddlDeptAmtStatus" onchange="SaleOrderDetailList()" class="form-select search_ddl select2 ">
                <option value="">All</option>
                <option value="Y">Received</option>
                <option value="N">Not Received</option>         
            </select>
        </div>
        <div class="col-md-2 fw-bold">
                <label for="ddlSaleDeptName" class="form-label fw-bold fs-6">
                Department Name
            </label>
            <select id="ddlSaleDeptName" onchange="SaleOrderDetailList()" class=" form-select search_ddl select2">
            </select>
        @*     <span class="error"></span> *@
        </div>
        <div class="col-lg-2 fw-bold">
            <label for="ddlSaleAgency" class="form-label fw-bold fs-6"> Agency </label>
            <select id="ddlSaleAgencyName" onchange="SaleOrderDetailList()" class="form-select search_ddl select2">               
            </select>
        </div>
        </div>
    <div class="from-group row">
        <div class="col-md-2 fw-bold">
            <label class="form-label">Sale Inv. Status</label>
            <select id="ddlSaleInvStatus" onchange="SaleOrderDetailList()" class="form-select search_ddl select2">
                <option value="">All</option>
                <option value="Y">Completely Generated</option>
                <option value="P">Partially Generated</option>
                <option value="N">Not Generated</option>
            </select>
        </div>
        <div  class="col-md-8">

        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="button" class="btn btn-danger w-100" id="btnExport">
                <i class="bi bi-file-earmark-excel"></i> Export To Excel
            </button>
        </div>

    </div>
</div>
<!-- List Div -->
<div id="listDiv" class="card shadow p-3">

    <div class="pt-2" style="width:100%; overflow-x:auto;">
        <table id="myTableSaleOrderDetail" class="table table-sm table-bordered mb-0">
            <thead class="table-info">
                <tr>
                    <th>Sr.No</th>
                    <th>Sale Order<br />Ref.No.</th>
                    <th>Department Name</th>
                    <th>Billing Address</th>
                    <th>Order Amt.</th>
                    <th>Dept.Order Date</th>
                    <th>Order Entry Date</th>
                    <th>Dept. Amt.</th>
                    <th>Item</th>
                    <th>Agency</th>
                    <th>Issued Date</th>
                    <th>Invoiced Status</th>
                    <th>Invoiced Item</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot class="tfoot bg-primary"></tfoot>
        </table>
    </div>

</div>

@section Scripts {
    <script src="~/PageAssets/Hardware/Js/HardwareMaster/SaleOrderDetails.js" asp-append-version="true"></script>
}