@using System.Security.Claims
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var roleId = User.FindFirst("RoleId")?.Value;
    var userId = User.FindFirst("UserId")?.Value;
    var deptId = User.FindFirst("DeptId")?.Value;
}
@{
    Layout = "~/Views/Shared/_TestLayout.cshtml";
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
}
<div class="container">
    <div class="form-group row mb-0">
        <div class="col-md-2 text-sm-start fw-bold text-info">
            <label class="form-label-sm mb-0">HPSEDC Refference No.<span class="text-danger">*</span></label>
            <input type="text" id="txtHPSEDCReffNo" readonly class="form-control  txtbx mt-0 cleartxt" placeholder="HPSEDC Refference No." />
            <span class="error"></span>
        </div>
        <div class="col-md-2 text-sm-start fw-bold text-info">
            <label class="form-label-sm mb-0">Department Name<span class="text-danger">*</span></label>
            <input type="text" id="txtDeptName" readonly class="form-control numericOnly txtbx mt-0 cleartxt" placeholder="Department Name" />
            <span class="error"></span>
        </div>
        <div class="col-md-2 text-sm-start fw-bold text-info">
            <label class="form-label-sm mb-0">Billing Address<span class="text-danger">*</span></label>
            <input type="text" id="txtBillingAddr" readonly class="form-control numericOnly txtbx mt-0 cleartxt" placeholder="Billing Address" />
            <span class="error"></span>
        </div>
        <div class="col-md-2 text-sm-start fw-bold text-info">
            <label class="form-label-sm mb-0">Refference No.<span class="text-danger">*</span></label>
            <input type="text" id="txtReffrNo" readonly class="form-control numericOnly txtbx mt-0 cleartxt" placeholder="Refference No." />
            <span class="error"></span>
        </div>
        <div class="col-md-2 text-sm-start fw-bold text-info">
            <label class="form-label-sm mb-0">Dept Order Date<span class="text-danger">*</span></label>
            <input type="text" id="txtOrderDate" readonly class="form-control numericOnly txtbx mt-0 cleartxt" placeholder="Dept Order Date" />
            <span class="error"></span>
        </div>
        <div class="col-md-2 text-sm-start fw-bold text-info">
            <label class="form-label-sm mb-0">Order Entry Date<span class="text-danger">*</span></label>
            <input type="text" id="txtEntryDate" readonly class="form-control numericOnly txtbx mt-0 cleartxt" placeholder="Entry Date" />
            <span class="error"></span>
        </div>
    </div>

    <!-- List Div -->
    <div id="listDiv" style="display:block;">
        <h5></h5>
        <table id="myTableProductDetail" class="table table-striped table-bordered">
            <thead class="table-info">
                <tr>
                    <th>Main Category</th>
                    <th>Brand</th>
                    <th>Product Category</th>
                    <th>Item Name With Model</th>
                    <th>Specification</th>
                    <th>Quantity</th>
                    <th>Rate Per Price</th>
                    <th>Total Rate</th>
                    <th>Admin Charge</th>
                    <th>GST</th>
                    <th>Total</th>
                    <th>Narration</th>



                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="tfoot bg-primary">
            </tfoot>
        </table>
    </div>
    <div class="form-group row mb-0">
        <div class="col-md-3 text-sm-start fw-bold">
            <label class="form-label-sm mb-0">
                Department Location Document
                <span class="text-danger">*</span>
            </label>
            <button type="button" id="btnView" class="btn btn-danger mt-1 d-block">
                View
            </button>

            <!--Modal for View Details-->
            <div class="modal" id="myModalViewDetails">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">

                        <!-- Modal Header -->
                        <div class="modal-header  bg-ld ">
                            <h4 class="modal-title txt-white" id="myModalLabel1">View Details</h4>
                            <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                        </div>

                        <!-- Modal body -->
                        <div class="container mt-5">
                            <h2 class="mb-4"></h2>

                            <table id="myTableConsigneeAddress" class="table table-striped table-bordered">
                                <thead class="table-info">
                                    <tr>
                                        <th>Sr.No</th>
                                        <th>Milestone</th>
                                        <th>Status</th>
                                        <th>Current Status</th>





                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                <tfoot class="tfoot bg-primary">
                                </tfoot>
                            </table>

                        </div>

                        <!-- Modal footer -->
                        <div class="modal-footer  bg-ld ">
                            <div class="me-auto">
                                <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                            </div>
                            <div class="flex-grow-1 text-center modelalert text-danger"></div>

                            <button type="button" data-bs-dismiss="modal" class="btn btnModel">Close</button>

                        </div>

                    </div>
                </div>
            </div>

            <span class="error"></span>
        </div>
        <div class="col-md-2 text-sm-start fw-bold text-info">
            <label class="form-label-sm mb-0">Total Price<span class="text-danger">*</span></label>
            <input type="text" id="txtTPrice" readonly class="form-control numericOnly txtbx mt-0 cleartxt" placeholder="Total Price" />
            <span class="error"></span>
        </div>
        <div class="col-md-2 text-sm-start fw-bold text-info">
            <label class="form-label-sm mb-0">Admin Charge<span class="text-danger">*</span></label>
            <input type="text" id="txtAdminCharge" readonly class="form-control numericOnly txtbx mt-0 cleartxt" placeholder="Admin Charge" />
            <span class="error"></span>
        </div>
        <div class="col-md-2 text-sm-start fw-bold text-info">
            <label class="form-label-sm mb-0">GST<span class="text-danger">*</span></label>
            <input type="text" id="txtGST" readonly class="form-control numericOnly txtbx mt-0 cleartxt" placeholder="GST" />
            <span class="error"></span>
        </div>
        <div class="col-md-2 text-sm-start fw-bold text-info">
            <label class="form-label-sm mb-0">Grand Total<span class="text-danger">*</span></label>
            <input type="text" id="txtGTotal" readonly class="form-control numericOnly txtbx mt-0 cleartxt" placeholder="Grand Total" />
            <span class="error"></span>
        </div>
    </div>
    <div class="d-flex align-items-start gap-4">

        <!-- Radio Buttons -->
        <div class="d-flex align-items-center gap-3 mt-2">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="verifyOption" checked id="verifyOption" value="V">
                <label class="form-check-label fw-bold" for="verifyOption">Verify</label>
            </div>

            <div class="form-check">
                <input class="form-check-input" type="radio" name="verifyOption" id="verifyOption" value="R">
                <label class="form-check-label fw-bold" for="verifyOption">Not Verify</label>
            </div>
        </div>

        <!-- Remarks -->
        <div class=" col-md-4 form-check ms-6">
            <label for="txtareaRemark" class="form-label fw-bold">Remarks</label>
            <textarea class="form-control cleartxt" id="txtareaRemark" rows="2" placeholder="Enter remarks"></textarea>
            <span class="error"></span>
        </div>
        <div class="flex-grow-1 text-center modelalert text-danger">
            <button type="button" class="btn btnModel btnModalSubmit" id="btnSubmit">Submit</button>
        </div>

          
       
    </div>

</div>







@section Scripts {
    <script src="~/PageAssets/Hardware/Js/HardwareMaster/SaleOrderVerify.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
}