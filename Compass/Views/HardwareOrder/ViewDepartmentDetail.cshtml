    <!--Modal for Feedback-->
    <div class="modal fade" id="feedbackModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content rounded-3">

                <!-- Header -->
                <div class="modal-header bg-ld">
                    <h5 class="modal-title">Feedback</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <!-- Body -->
                <div class="modal-body text-center">

                    <h6>Rate Your Experience</h6>

                    <!-- Star Rating -->
                    <div class="star-rating mb-3">
                        <i class="fa fa-star" data-value="1"></i>
                        <i class="fa fa-star" data-value="2"></i>
                        <i class="fa fa-star" data-value="3"></i>
                        <i class="fa fa-star" data-value="4"></i>
                        <i class="fa fa-star" data-value="5"></i>
                    </div>

                    <!-- Comment -->
                    <textarea class="form-control" id="feedbackText" placeholder="Write your feedback..."></textarea>
                    <span class="error"></span>
                </div>

                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-success btnModalFeedbackSubmit" id="btnModalFeedbackSubmit">Submit</button>
                </div>

            </div>
        </div>
