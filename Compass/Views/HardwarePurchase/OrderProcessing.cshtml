                            </tbody>
                            <tfoot class="tfoot bg-primary">
                            </tfoot>
                        </table>
                        <div class="d-flex justify-content-end">
                            <button type="button" class="btn btnModel btn-sm btnModalReset me-2">Reset</button>
                            <button type="button" class="btn btnModel btn-sm btnModalGenerate">Generate Product List</button>
                        </div>

                        <div class="mb-2 text-center text-danger">
                            <h4 class="mb-4">Kindly verify the products and amounts, and please enter the HSN codes. </h4>

                            <table id="myTableHSNInvoice" class="table table-striped table-bordered">
                                <thead class="table-info">
                                    <tr>
                                        <th>Sr.No</th>
                                        <th>Product Name</th>
                                        <th>Quantity</th>
                                        <th>HSN Code</th>
                                        <th>Rate</th>
                                        <th>GST</th>
                                        <th>Total</th>
                                        <th>GTotal</th>




                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                <tfoot class="tfoot bg-primary">
                                </tfoot>
                            </table>
                        </div>
                        <div class="card">
                            <div class="card-body border-3" style="border: 1px solid red;">
                                <div class="form-group row mb-0">
                                    <div class="col-md-4 text-sm-start">
                                        <label class="form-label-sm mb-0 fw-bold">Basic Bill Amount<span class="text-danger">*</span></label>
                                        <input type="text" id="txtBasicAmt" readonly class="form-control  txtbx mt-0 cleartxt" placeholder="Agency Name" />
                                        <span class="error"></span>
                                    </div>
                                    <div class="col-md-4 text-sm-start">
                                        <label class="form-label-sm mb-0 fw-bold">IGST<span class="text-danger">*</span></label>
                                        <input type="text" id="txtIgst" readonly class="form-control numericOnly txtbx mt-0 cleartxt" placeholder="Depart Name" />
                                        <span class="error"></span>
                                    </div>
                                    <div class="col-md-4 text-sm-start">
                                        <label class="form-label-sm mb-0 fw-bold">CGST<span class="text-danger">*</span></label>
                                        <input type="text" id="txtCgst" readonly class="form-control numericOnly txtbx mt-0 cleartxt" placeholder="Depart Name" />
                                        <span class="error"></span>
                                    </div>
                                </div>
                                <div class="form-group row mb-0">
                                    <div class="col-md-4 text-sm-start">
                                        <label class="form-label-sm mb-0 fw-bold">SGST<span class="text-danger">*</span></label>
                                        <input type="text" id="txtSgst" readonly class="form-control  txtbx mt-0 cleartxt" placeholder="Agency Name" />
                                        <span class="error"></span>
                                    </div>
                                    <div class="col-md-6 d-flex align-items-end">

                                        <div class="w-75 me-2">
                                            <label class="form-label-sm mb-0 fw-bold">
                                                Total Amount<span class="text-danger">*</span>
                                            </label>
                                            <input type="text" id="txtTAmount" readonly
                                                   class="form-control numericOnly txtbx mt-0 cleartxt" />
                                        </div>

                                        <button class="btn btnModel btnModelInvoiceSubmit">
                                            Submit
                                        </button>

                                    </div>
                                </div>

                                

                            </div>
                        </div>



                    </div>

                   
                    <!-- Modal footer -->
                    <div class="modal-footer  bg-ld ">
                        <div class="me-auto">
                            <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                        </div>
                        <div class="flex-grow-1 text-center modelalert text-danger"></div>
                        @*  <button type="button" class="btn btnModel btnModalSubmit">Submit</button> *@
                        <button type="button" data-bs-dismiss="modal" class="btn btnModel">Close</button>

                    </div>


                </div>
            </div>
        </div>
    </div>

   









}


