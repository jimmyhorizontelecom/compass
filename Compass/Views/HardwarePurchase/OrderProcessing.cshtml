<style>
    div.dataTables_wrapper div.dataTables_length {
        float: left !important;
        margin-right: auto;
    }

    #ddlDept + .error,
    label[for="ddlDept"] {
        font-size: 20px;
    }

    .star-rating i {
        font-size: 25px;
        color: #ccc;
        cursor: pointer;
    }

        .star-rating i.active {
            color: gold;
        }

    .statusGreen {
        background-color: forestgreen;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .statusOrange {
        background-color: orange;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .modal-content {
        border-radius: 0 !important;
    }

    .my-modal .modal-content {
        border: 4px solid red;
    }

    .custom-border {
        border: 2px solid red; /* color change kar sakte ho */
        border-radius: 8px;
    }

    .card-body:hover {
        border: 2px solid green;
        transition: 0.3s;
    }
</style>





<!-- List Div -->

<div id="listDiv" class="card p-3 shadow text-center">
    <h5>Order Processing</h5>
    <div class="card p-3 shadow text-center">
        <div class="form-group row">
            <div class="col-md-2 fw-bold text-sm-start">
                <label class="col-form-label-sm mb-0">Department Name Filter<span class="text-danger">*</span></label>
                <select id="ddlDept" class="form-select search_ddl select2" aria-label=".form-select-sm">
                </select>
                <span class="error"></span>
            </div>
            <div class="col-md-3 fw-bold text-start">
                <label class="form-label">Delivery Status<span class="text-danger">*</span></label>
                <select id="ddlDelivery" class="form-select search_ddl select2" aria-label=".form-select-sm">
                </select>
                <span class="error"></span>
            </div>
            <div class="col-md-3 fw-bold text-start">
                <label class="form-label">Invoice Status<span class="text-danger">*</span></label>
                <select id="ddlStatus" class="form-select search_ddl select2" aria-label=".form-select-sm">
                </select>
                <span class="error"></span>
            </div>

        </div>
    </div>
    <div style="width:100%; overflow-x:auto;">
        <table id="myTableOrderProcess" class="table table-striped table-bordered">
            <thead class="table-info">
                <tr>
                    <th>Sr.No</th>
                    <th>Order No.<br />PO Date</th>
                    <th>Department Name</th>
                    <th>Agency Name</th>
                    <th>Amount</th>
                    <th>Department Amt.Received</th>
                    <th>Dept.Order Doc</th>
                    <th>Add Location</th>
                    <th>View Detail</th>
                    <th>HPSEDC Purchase Order</th>
                    <th>Product Delivery</th>
                    <th>Verify POD/IR</th>
                    <th>Agency Invoice</th>
                    <th>View Agency Invoice</th>
                    <th>View Agency Payment</th>

                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="tfoot bg-primary">
            </tfoot>
        </table>
    </div>

</div>

