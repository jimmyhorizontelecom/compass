@using System.Security.Claims
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{

    var roleId = User.FindFirst("RoleId")?.Value;
    var userId = User.FindFirst("UserId")?.Value;
    var deptId = User.FindFirst("DeptId")?.Value;
}
@{
    Layout = "~/Views/Shared/_TestLayout.cshtml";
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css">

    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
}
<style>


    .star-rating i {
        font-size: 25px;
        color: #ccc;
        cursor: pointer;
    }

        .star-rating i.active {
            color: gold;
        }

    .statusGreen {
        background-color: forestgreen;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .statusOrange {
        background-color: orange;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .modal-content {
        border-radius: 0 !important;
    }

    .my-modal .modal-content {
        border: 4px solid red;
    }

    .large-card-body {
        min-height: 400px;
        padding: 20px;
    }

    #txtTermConditionRemark {
        resize: vertical;
        border-radius: 10px;
        font-size: 15px;
    }

    .card-header {
        border-radius: 8px 8px 0 0;
    }

    .terms-label {
        margin-bottom: 2px;
    }

    .table td,
    .table th {
        padding: 0.35rem 0.5rem; /* Reduce row height */
        vertical-align: middle;
    }

</style>
<!-- Card Header -->
<div class="card-header bg-white border-0 text-center py-4">
    <h2 class="fw-normal text-dark">
        Create Agency Login
    </h2>
</div>
<div class="container-fluid mt-4">

    <div class="card border-0 shadow-lg rounded-4">

       

        <!-- Card Body -->
        <div class="card-body p-5">

            <div class="row g-4">

                <div class="col-lg-4">
                    <label for="ddlPOAgency" class="form-label fw-bold fs-6">
                        Agency
                    </label>
                    <select id="ddlPOAgency" class="form-select">
                        <option>Select option</option>
                    </select>
                </div>

                <div class="col-lg-4 text-sm-start fw-bold">
                    <label for="txtAgencyEmail" class="form-label">Agency Email</label>
                    <input readonly type="email"
                           id="txtPOAgencyEmail"
                           class="form-control"
                           placeholder="Email">
                </div>

                <div class="col-lg-4 text-sm-start fw-bold">
                    <label class="form-label">Agency Phone No.</label>
                    <input readonly type="text" id="txtPOAgencyPhoneNo" class="form-control" placeholder="Phone No">
                </div>

                <div class="col-lg-4 text-sm-start fw-bold">
                    <label class="form-label">Agency Address</label>
                    <input readonly type="text" id="txtPOAgencyAddress" class="form-control" placeholder="Address">
                </div>

                <div class="col-lg-4 text-sm-start fw-bold">
                    <label class="form-label">First Name<span class="text-danger">*</span></label>
                    <input type="text" id="txtPOFirstName" class="form-control" placeholder="First Name">
                    <span class="error"></span>
                </div>

                <div class="col-lg-4 text-sm-start fw-bold">
                    <label class="form-label">Last Name<span class="text-danger">*</span></label>
                    <input type="text" id="txtPOLastName" class="form-control" placeholder="Last Name">
                    <span class="error"></span>
                </div>

                <div class="col-lg-4 text-sm-start fw-bold">
                    <label class="form-label">User Name<span class="text-danger">*</span></label>
                    <input type="text" id="txtPOUserName" class="form-control" placeholder="User Name">
                    <span class="error"></span>
                </div>

                <div class="col-lg-4 text-sm-start fw-bold">
                    <label class="form-label">Password<span class="text-danger">*</span></label>
                    <input type="password" id="txtPOPassword" class="form-control" placeholder="Password">
                    <span class="error"></span>
                </div>

                <div class="col-lg-4 d-flex align-items-end justify-content-center">
                    <button class="btn btn-danger px-5 py-2 rounded-3 fw-bold btnCreate createButton">
                        Create
                    </button>
                </div>

            </div>

        </div>

    </div>

</div>

<!-- List Div -->

<div id="listDiv" class="card shadow p-3 mt-4">

    <div class="pt-2" style="width:100%; overflow-x:auto;">
        <table id="myTableCreateAgencyLogin" class="table table-sm table-bordered mb-0">
            <thead class="table-info">
                <tr>
                    <th>Sr.No</th>
                    <th>Agency Name</th>
                    <th>User Name</th>
                    <th>Password</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot class="tfoot bg-primary"></tfoot>
        </table>
    </div>

</div>



@section Scripts {
    <script src="~/PageAssets/Hardware/Js/HardwareMaster/CreateAgencyLogin.js" asp-append-version="true"></script>
}