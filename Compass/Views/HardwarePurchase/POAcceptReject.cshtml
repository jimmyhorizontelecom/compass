<style>
    div.dataTables_wrapper div.dataTables_length {
        float: left !important;
        margin-right: auto;
    }

    .star-rating i {
        font-size: 25px;
        color: #ccc;
        cursor: pointer;
    }

        .star-rating i.active {
            color: gold;
        }

    .statusGreen {
        background-color: forestgreen;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .statusOrange {
        background-color: orange;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .modal-content {
        border-radius: 0 !important;
    }

    .my-modal .modal-content {
        border: 4px solid red;
    }
</style>





<!-- List Div -->

<div id="listDiv" class="card p-3 shadow">
    <h5>PO AcceptReject</h5>
    <div style="width:100%; overflow-x:auto;">
        <table id="myTablePOVerification" class="table table-striped table-bordered">
            <thead class="table-info">
                <tr>
                    <th>Sr.No</th>
                    <th>Order No.<br /> Purchase Order Date</th>
                    <th>Department Name</th>
                    <th>Agency Name</th>
                    <th>Amount</th>
                    <th>Dept. Order Doc</th>
                    <th>View Detail</th>
                    <th>Delivery Location</th>
                    <th>HPSEDC Purchase Order</th>
                    <th>Accept/Reject</th>

                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="tfoot bg-primary">
            </tfoot>
        </table>
    </div>

</div>

@section Modals {

    <!--Modal for Item Description-->
    <div class="modal" id="myModalitemDescription">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel2">Issues Purchase Order</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow-x:auto;">

                    <div class="container mt-5">
                        <h2 class="mb-4"></h2>

                        <table id="myTableItemDesc1" class="table table-striped table-bordered">
                            <thead class="table-info">
                                <tr>
                                    <th>Sr.No</th>
                                    <th>Item Description</th>
                                    <th>Quantity</th>
                                    <th>Base Price</th>
                                    <th>GST%</th>
                                    <th>Unit Rate(Inclusive Tax)</th>
                                    <th>Total Amt(Inclusive Tax)</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                            <tfoot class="tfoot bg-primary">
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Modal footer -->
                <div class="modal-footer  bg-ld ">
                    <div class="me-auto">
                        <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                    </div>
                    <div class="flex-grow-1 text-center modelalert text-danger"></div>
                    @*  <button type="button" class="btn btnModel btnModalSubmit">Submit</button> *@
                    <button type="button" data-bs-dismiss="modal" class="btn btnModel">OK</button>

                </div>

            </div>
        </div>
    </div>

    <!--Modal for delivery address-->

    <div class="modal" id="myModalDeliveryAdd">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel1"> Delivery Address</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow-x:auto;">
                    <div class="container mt-5">
                        <div class="container mt-5">
                            <h2 class="mb-4"></h2>
                            <table id="myTableAddLocation2" class="table table-striped table-bordered">
                                <thead class="table-info">
                                    <tr>
                                        <th>Sr.No</th>
                                        <th>Product Name</th>
                                        <th>Delivery Quantity</th>
                                        <th>Consignee Name</th>
                                        <th>Contact No.</th>
                                        <th>Consignee Address</th>
                                        <th>Address Type</th>





                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                <tfoot class="tfoot bg-primary">
                                </tfoot>
                            </table>
                        </div>




                    </div>

                    <!-- Modal footer -->
                    <!-- Modal footer -->
                    <div class="modal-footer  bg-ld ">
                        <div class="me-auto">
                            <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                        </div>
                        <div class="flex-grow-1 text-center modelalert text-danger"></div>
                        <button type="button" data-bs-dismiss="modal" class="btn btnModel">OK</button>

                    </div>


                </div>
            </div>
        </div>
    </div>

    <!--Modal for Accept/Reject-->
    <div class="modal fade" id="myModalVerificationStatus">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel3">Accept And Reject</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow-x:auto;">
                    <div class="card-body modal-xl border border-danger border-4">
                        <!-- Remarks -->
                        <div class="form-group row">
                            <div class="d-flex align-items-center">
                                <div class="col-md-4 text-sm-start">


                                    <div class="form-check form-check-inline ms-4">
                                        <input class="form-check-input" type="radio" name="AcceptReject" id="AcceptReject" value="A">
                                        <label class="form-check-label" for="Accept">Accept</label>
                                    </div>

                                    <div class="form-check form-check-inline gap-3">
                                        <input class="form-check-input" type="radio" name="AcceptReject" id="AcceptReject" value="R" checked>
                                        <label class="form-check-label" for="Reject">Reject</label>
                                    </div>
                                </div>
                            </div>
                            <div class=" col-md-10 ms-2">
                                <label for="txtareaRemark" class="form-label fw-bold">Remarks</label>
                                <textarea class="form-control cleartxt" id="txtareaVRemark" rows="2" placeholder=""></textarea>
                                <span class="error"></span>
                            </div>
                        </div>

                    </div>

                </div>

                <!-- Modal footer -->
                <div class="modal-footer  bg-ld ">
                    <div class="me-auto">
                        <img src="~/images/ajax-loader.gif" id="ModalProgress" style="display:none;" />
                    </div>
                    <div class="flex-grow-1 text-center modelalert text-danger"></div>

                    <button type="button" class="btn btn-danger  btnModalRemarkSubmit">Submit</button>

                </div>

            </div>
        </div>
    </div>










}


@section Scripts {
    <script src="~/PageAssets/Hardware/Js/HardwareMaster/POAcceptReject.js" asp-append-version="true"></script>
}