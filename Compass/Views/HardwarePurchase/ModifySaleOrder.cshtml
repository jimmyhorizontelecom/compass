<style>


    .star-rating i {
        font-size: 25px;
        color: #ccc;
        cursor: pointer;
    }

        .star-rating i.active {
            color: gold;
        }

    .statusGreen {
        background-color: forestgreen;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .statusOrange {
        background-color: orange;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .modal-content {
        border-radius: 0 !important;
    }

    .my-modal .modal-content {
        border: 4px solid red;
    }

    .large-card-body {
        min-height: 400px;
        padding: 20px;
    }

   

    .card-header {
        border-radius: 8px 8px 0 0;
    }

    .terms-label {
        margin-bottom: 2px;
    }

    .table td,
    .table th {
        padding: 0.35rem 0.5rem; /* Reduce row height */
        vertical-align: middle;
    }

</style>

<div class="text-center">
    <h4 class="fw-bold">Modify Sale Order</h4>
</div>
<div class="card m-lg-3 padding-10 shadow-sm">
    <div class="col-md-2 ms-3">
        <label class="form-label">
            Sale Order <span class="text-danger">*</span>
        </label>

        <select id="ddlModifySale"
                class="form-select search_ddl select2">
        </select>

        <span class="error"></span>
    </div>
</div>


<!-- Table Card -->
<div id="listDiv" class="card p-3 shadow">
    <!-- Scroll only for table -->
    <div class="table-responsive">
        <table id="myTableSaleOrderModify"  class="table table-sm table-bordered mb-0">
            <thead class="table-info">
                <tr>
                    <th>Sr.No</th>
                    <th>  Select All
                        <input type="checkbox" id="selectAll">
                    </th>
                    <th>Product Category</th>
                    <th>Model No.</th>
                    <th>Item Description</th>
                    <th>Prev. Qty</th>
                    <th>New Qty.</th>
                    <th>Price</th>
                    <th>Total Amt.</th>
                    <th>Admin Amt.</th>
                    <th>Gst Amt.</th>
                    <th>GTotal Amt.</th>
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot class="tfoot bg-primary"></tfoot>
        </table>
    </div>

</div>
@* <-- Outside Scroll --> *@
<div class="card shadow">
    <div class="card-body">
        <div class="row align-items-center">
            <!-- Attach Document -->
            <div class="col-md-2 fw-bold">
                <label for="AttachDocument" class="form-label mb-1"> Attach Document </label>
                <input class="form-control form-control-sm"  id="AttachDocument" type="file">
            </div>
            <div class="col-md-7 "> </div>
            <!-- Submit Button - End & Center -->
            <div class="col-md-3 d-flex justify-content-end align-items-center">
                <button type="button"  id="btnSubmit"  class="btn btn-danger  btnModifySubmit"> Submit </button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/PageAssets/Hardware/Js/HardwareMaster/ModifySaleOrder.js" asp-append-version="true"></script>
}