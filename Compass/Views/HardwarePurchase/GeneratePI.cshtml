                                <label for="remark" class="form-label">Additional Information</label>
                                <textarea class="form-control cleartxt" id="txtAreaInformation" rows="3" placeholder="EnterConsigneeAddress Here..."></textarea>
                                <span class="error"></span>
                            </div>

                        </div>
                        <div class="form-group  row mb-0">
                            <div class="col-md-3 text-sm-start fw-bold">
                                <label for="remark" class="form-label">Items Heading</label>
                                <textarea class="form-control cleartxt" id="txtAreaItemHeading" rows="3" placeholder=""></textarea>
                                <span class="error"></span>
                            </div>
                        </div>



                    </div>
                </div>

                <div class="container mt-5">
                    <h2 class="mb-4"></h2>

                    <table id="myTableAddCart" class="table table-striped table-bordered">
                        <thead class="table-info">
                            <tr>

                                <th>Sr.No</th>

                                <th>Product Name</th>
                                <th>Base Price</th>
                                <th>Admin Charge</th>
                                <th>Gst</th>
                                <th>GTotal</th>
                                <th>Quantity</th>
                                <th>Total Amount</th>
                                <th>Remove</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>

                    </table>
                </div>
                <div class="card">
                    <div class="card-body">
                        <div class="form-group row mb-0">
                            <div class="col-md-3 text-sm-start fw-bold">
                                <label class="form-label-sm mb-0">Base Price<span class="text-danger">*</span></label>
                                <input type="text" id="txtBasePrice" readonly class="form-control txtbx mt-0 cleartxt" />
                            </div>

                            <div class="col-md-3 text-sm-start fw-bold">
                                <label class="form-label-sm mb-0">Admin Charge<span class="text-danger">*</span></label>
                                <input type="text" id="txtAdminCharge" readonly class="form-control txtbx mt-0 cleartxt" />
                            </div>

                            <div class="col-md-3 text-sm-start fw-bold">
                                <label class="form-label-sm mb-0">Gst<span class="text-danger">*</span></label>
                                <input type="text" id="txtGst" readonly class="form-control txtbx mt-0 cleartxt" />
