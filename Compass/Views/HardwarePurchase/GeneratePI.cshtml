@using System.Security.Claims
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var roleId = User.FindFirst("RoleId")?.Value;
    var userId = User.FindFirst("UserId")?.Value;
    var deptId = User.FindFirst("DeptId")?.Value;
}
@{
    Layout = "~/Views/Shared/_TestLayout.cshtml";
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
}
<style>
    .added-box {
        border: 1px solid green;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        color: #28a745;
        border-radius: 20px; /* rectangle (not fully rounded) */
        font-size: 14px;
        font-weight: 500;
    }
</style>
<!-- Buttons -->
<h4 class="mb-0 text-center fw-bold">Proforma Invoice</h4>
<div class="card mb-3 p-3">

    <div class="row align-items-end">
        <div class="form-group row">
            <!-- Buttons -->
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-danger btn-md" onclick="showDiv('newSaleDiv')">
                    ➕ Generate PI
                </button>

                <button class="btn btn-secondary btn-md" onclick="showDiv('listDiv')">
                    📋 PI List
                </button>

            </div>

           
        </div>



    </div>
</div>


<!-- New Sale Div -->
<div id="newSaleDiv" class="card p-3 shadow">
    <div class="form-group row">
        <div class="col-md-2 ">
            <label class="form-label">Main Category<span class="text-danger">*</span></label>
            <select id="ddlMainCatg" class="form-select search_ddl select2" aria-label=".form-select-sm">
            </select>
            <span class="error"></span>
        </div>
        <div class="col-md-2 ">
            <label class="form-label">Product Category<span class="text-danger">*</span></label>
            <select id="ddlPrdCatg" class="form-select search_ddl select2" aria-label=".form-select-sm">
            </select>
            <span class="error"></span>
        </div>
        <div class="col-md-2 ">
            <label class="form-label">Brand<span class="text-danger">*</span></label>
            <select id="ddlBrand" class="form-select search_ddl select2" aria-label=".form-select-sm">
            </select>
            <span class="error"></span>
        </div>
        <!-- Cart Icon -->
        <div class="col-md-6 d-flex justify-content-end" style="position: relative;">

            <div class="cartbtn" style="position: relative;">
                <i class="bi bi-cart fs-2"></i>

                <!-- Badge -->
                <span id="cartCount"
                      style="position: absolute; top: -8px; right: -10px;
                    background: red; color: white;
                    border-radius: 50%; padding: 3px 7px;
                    font-size: 12px;">
                    0
                </span>
            </div>

        </div>

       
       
    </div>

    <!-- Sale Item List -->

    <div id="SaleItem" class="card p-3 shadow">
        <h5></h5>
        <input type="text" id="customSearch" class="form-control mb-2" placeholder="Search product...">
        <table id="myTablePIGenerate" class="table table-bordered border-primary">
            <thead class="table-info">
                <tr>
                    <th>Sr.No</th>
                    <th>Main Category Name</th>
                    <th>Brand Name</th>
                    <th>Product Name</th>
                    <th>Model No.</th>
                    <th>Base Price</th>
                    <th>HPSEDC Charge(%)</th>
                    <th>GST(%)</th>
                    <th>GrandTotal</th>
                    <th>Specifications</th>
                    <th>Action to Cart</th>

                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="tfoot bg-primary">
            </tfoot>
        </table>
        <div id="pagination" class="mt-2"></div>
    </div>

</div>
<!-- New Sale Div -->
<div id="listDiv" class="card p-3 shadow">
    <div class="form-group row">
        <div class="col-md-2 ">
            <label class="form-label">Department Name<span class="text-danger">*</span></label>
            <select id="ddlDeptNamePI" class="form-select search_ddl select2" aria-label=".form-select-sm">
            </select>
            <span class="error"></span>
        </div>
        <div class="col-md-2 ">
            <label class="form-label">Billing Address<span class="text-danger">*</span></label>
            <select id="ddlBillAddr" class="form-select search_ddl select2" aria-label=".form-select-sm">
            </select>
            <span class="error"></span>
        </div>

        
       

    </div>

    <!-- Sale Item List -->

    <div id="SaleItem" class="card p-3 shadow">
        <h5></h5>
        @*  <input type="text" id="customSearch" class="form-control mb-2" placeholder="Search product..."> *@
        <table id="myTablePIList" class="table table-bordered border-primary">
            <thead class="table-info">
                <tr>
                    <th>Sr.No.</th>
                    <th>PI No.</th>
                    <th>PI Date</th>
                    <th>PB No.<br />PB Date</th>
                    <th>Reference No.</th>
                    <th>Department</th>
                    <th>PI Address</th>
                    <th>Print PI</th>
                    <th>Confirm Order</th>
                    <th>Porforma Bill</th>
                    <th>Print PB</th>

                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="tfoot bg-primary">
            </tfoot>
        </table>
        <div id="pagination" class="mt-2"></div>
    </div>

</div>
<!--Modal for Cart-->
