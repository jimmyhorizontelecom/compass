}
<style>

   
    .star-rating i {
        font-size: 25px;
        color: #ccc;
        cursor: pointer;
    }

        .star-rating i.active {
            color: gold;
        }

    .statusGreen {
        background-color: forestgreen;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .statusOrange {
        background-color: orange;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .modal-content {
        border-radius: 0 !important;
    }

    .my-modal .modal-content {
        border: 4px solid red;
    }

    .large-card-body {
        min-height: 400px;
        padding: 20px;
    }

    #txtTermConditionRemark {
        resize: vertical;
        border-radius: 10px;
        font-size: 15px;
    }

    .card-header {
        border-radius: 8px 8px 0 0;
    }

    .terms-label {
        margin-bottom: 2px;
    }

    .table td,
    .table th {
        padding: 0.35rem 0.5rem; /* Reduce row height */
        vertical-align: middle;
    }

</style>
<!-- Buttons -->
<div class="text-center">
    <h4 class="fw-bold">Add Term Type Condition</h4>
</div>
<div class="card m-lg-3 padding-10 shadow-sm">
    <div class="card-body d-flex justify-content-end" style="height:100px; overflow-y:auto;">
        <button type="button" class="btn btn-danger btnAddTermType">
            <i class="fa fa-plus me-2 fs-4"></i>
            <span class="fw-bold">Add Condition Type</span>
        </button>

    </div>
</div>





<!-- List Div -->

<div id="listDiv" class="card p-6 shadow text-center">

    <div style="width:100%; overflow-x:auto;">
        <table id="myTableAddTermTypeCondition" class="table table-sm table-hover table-striped table-bordered mb-0">
            <thead class="table-info">
                <tr>
                    <th>Sr.No</th>
                    <th>Terms & Condition Name</th>
                    <th>Terms & Condition Type</th>

                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="tfoot bg-primary">
            </tfoot>
        </table>
    </div>

</div>

@section Modals {

    <!--Modal for Add Term Type Condition-->
    <div class="modal fade" id="myModalAddTermTypeCondition">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel3">Add Terms & Condition Type</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow-x:auto;">
                    <div class="card-body modal-xl border border-danger border-4">
                        <div class="row ps-3">
                            <div class="col-md-4 text-sm-start fw-bold">
                                <label class="form-label mb-0">
                                    Terms & Condition Name <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="txtTypeName" class="form-control txtbx mt-0 cleartxt" placeholder="Consignee Name" />
                                <span class="error"></span>
                            </div>

                            <div class="col-md-4 text-sm-start fw-bold">
                                <label class="form-label mb-0">
                                    Terms & Condition Type <span class="text-danger">*</span>
                                </label>
                                <select id="ddlTermTypeCondition" class="form-select search_ddl select2">
                                </select>
                            </div>
                        </div>

                        
                    </div>

                </div>

                <!-- Modal footer -->
                <div class="modal-footer  bg-ld ">

                    <div class="flex-grow-1 text-center modelalert text-danger"></div>

                    <button type="button" class="btn btn-danger  btnModalTypeSubmit">Submit</button>

                </div>

            </div>
        </div>
    </div>

   






}


@section Scripts {
    <script src="~/PageAssets/Hardware/Js/HardwareMaster/AddTermCondition.js" asp-append-version="true"></script>
}