@{

    var roleId = User.FindFirst("RoleId")?.Value;
    var userId = User.FindFirst("UserId")?.Value;
    var deptId = User.FindFirst("DeptId")?.Value;
}
@{
    Layout = "~/Views/Shared/_TestLayout.cshtml";
    // <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    // <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    // <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    // <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    // <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    // <script src="bootstrap.bundle.min.js"></script>
    // <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css">

    // <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    // <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    // <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    // <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
}
<style>


    .star-rating i {
        font-size: 25px;
        color: #ccc;
        cursor: pointer;
    }

        .star-rating i.active {
            color: gold;
        }

    .statusGreen {
        background-color: forestgreen;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .statusOrange {
        background-color: orange;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .modal-content {
        border-radius: 0 !important;
    }

    .my-modal .modal-content {
        border: 4px solid red;
    }

    .large-card-body {
        min-height: 400px;
        padding: 20px;
    }

    #txtTermConditionRemark {
        resize: vertical;
        border-radius: 10px;
        font-size: 15px;
    }

    .card-header {
        border-radius: 8px 8px 0 0;
    }

    .terms-label {
        margin-bottom: 2px;
    }

    .table td,
    .table th {
        padding: 0.35rem 0.5rem; /* Reduce row height */
        vertical-align: middle;
    }

</style>
<!-- Buttons -->
<div class="text-center">
    <h4 class="fw-bold">Terms & Condition Mapping</h4>
</div>
<div class="card m-lg-3 padding-10 shadow-sm">
    <div class="card-body d-flex justify-content-end" style="height:100px; overflow-y:auto;">
        <button type="button" class="btn btn-danger btnMapTermsCondition">
            <i class="fa fa-plus me-2 fs-4"></i>
            <span class="fw-bold">Map Terms & Condition</span>
        </button>
    </div>
</div>





<!-- List Div -->

<div id="listDiv" class="card p-3 m-lg-3 padding-10 shadow ">

    <div style="width:100%; overflow-x:auto;">
        <table id="myTableMappingTermsCondition" class="table table-sm table-hover table-striped table-bordered mb-0">
            <thead class="table-info">
                <tr>
                    <th>Sr.No</th>
                    <th>Product Category Name</th>
                    <th>Terms & Condition Details</th>

                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="tfoot bg-primary">
            </tfoot>
        </table>
    </div>

</div>

@section Modals {

    <!--Modal for Mapping Terms Condition-->
    <div class="modal fade" id="myModalMappingTermsCondition">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel3">Terms & Condition Mapping</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow-x:auto;">
                    <div class="card">
                        <div class="card-body">
                            <div class="form-group row mb-0">
                                <div class="col-md-5 text-sm-start fw-bold">
                                    <label class="form-label-sm ">Product Category<span class="text-danger">*</span></label>
                                    <select id="ddlPrdCategoryMap" class="form-select search_ddl select2" aria-label=".form-select-sm">
                                    </select>
                                </div>

                            </div>

                            <table id="myTableTermsAndMapping" class="table table-striped table-bordered">
                                <thead class="table-info">
                                    <tr>

                                        <th>Sr.No</th>
                                        <th>Select All<input type="checkbox" id="selectAllMapTerm"></th>
                                        <th>Terms & Condition Name</th>
                                        <th>Terms & Condition Details</th>

                                        
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>

                            </table>



                        </div>
                    </div>


                </div>

                <!-- Modal footer -->
                <div class="modal-footer  bg-ld ">

                    <div class="flex-grow-1 text-center modelalert text-danger"></div>

                    <button type="button" class="btn btn-danger  btnMappingSubmit">Submit</button>

                </div>

            </div>
        </div>
    </div>
    <!--Modal for View Details-->
    <div class="modal fade" id="myModalViewDetails">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel3"> View Terms & Conditions</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow-x:auto;">
                    <div class="card">
                        <div class="card-body">

                            
                            <table id="myTableViewTermsAndCondition" class="table table-striped table-bordered">
                                <thead class="table-info">
                                    <tr>

                                        <th>Sr.No</th>
                                        <th>Terms & Condition Name</th>
                                        <th>Terms & Condition Details</th>
                                        <th>Remove</th>


                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>

                            </table>



                        </div>
                    </div>


                </div>

                <!-- Modal footer -->
                <div class="modal-footer  bg-ld ">

                    <div class="flex-grow-1 text-center modelalert text-danger"></div>

                    <button type="button" class="btn btn-danger  btnMappingSubmit">Submit</button>

                </div>

            </div>
        </div>
    </div>









}


@section Scripts {
    <script src="~/PageAssets/Hardware/Js/HardwareMaster/TermsAndConditionMapping.js" asp-append-version="true"></script>
}