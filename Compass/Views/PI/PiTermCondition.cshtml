<style>

   
    .star-rating i {
        font-size: 25px;
        color: #ccc;
        cursor: pointer;
    }

        .star-rating i.active {
            color: gold;
        }

    .statusGreen {
        background-color: forestgreen;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .statusOrange {
        background-color: orange;
        width: 30px;
        height: 30px;
        border-radius: 15px;
    }

    .modal-content {
        border-radius: 0 !important;
    }

    .my-modal .modal-content {
        border: 4px solid red;
    }

    .large-card-body {
        min-height: 400px;
        padding: 20px;
    }

    #txtTermConditionRemark {
        resize: vertical;
        border-radius: 10px;
        font-size: 15px;
    }

    .card-header {
        border-radius: 8px 8px 0 0;
    }

    .terms-label {
        margin-bottom: 2px;
    }

</style>
<!-- Buttons -->
<div class="card m-lg-3 padding-10 shadow-sm">
    <div class="card-body d-flex justify-content-end" style="height:100px; overflow-y:auto;">
        <button type="button" class="btn btn-danger btnAddCategoryTerm">
            <i class="fa fa-plus me-2 fs-4"></i>
            <span class="fw-bold">Add Category Term & Condition</span>
        </button>

    </div>
</div>





<!-- List Div -->

<div id="listDiv" class="card p-3 m-lg-3 padding-10 shadow ">
    <h5 class="text-center">Term & Condition</h5>
    <div style="width:100%; overflow-x:auto;">
        @*     <table id="myTablePITermCondition" class="table table-striped table-bordered"> *@
        <table id="myTablePITermCondition" class="table table-bordered ">
            <thead class="table-info">
                <tr>
                    <th>Sr.No</th>
                    <th>Terms & Condition Name</th>
                    <th>Terms & Condition Details</th>
                    <th>Edit</th>

                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot class="tfoot bg-primary">
            </tfoot>
        </table>
    </div>

</div>

@section Modals {

    <!--Modal for Add Term & Condition-->
    <div class="modal fade" id="myModalAddTermCondition">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <!-- Modal Header -->
                <div class="modal-header  bg-ld ">
                    <h4 class="modal-title txt-white" id="myModalLabel3">Add New Category Terms & Condition</h4>
                    <button type="button" class="btn-close b-light" data-bs-dismiss="modal"></button>
                </div>

                <!-- Modal body -->
                <div class="modal-body" style="overflow-x:auto;">
                    <div class="card-body modal-xl border border-danger border-4">
                        <!-- Remarks -->
                        <div class="card shadow-sm border-0 mt-3">
                            @*   <div class="card-header bg-primary text-white">
                                <h5 class="mb-0">
                                    <i class="fa-solid fa-file-contract me-2"></i>
                                    Terms & Conditions
                                </h5>
                            </div> *@

                            <div class="card-body">

                                <div class="mb-3">
                                    <label class="form-label fw-bold " style="margin-bottom:0px;">
                                        Terms & Condition Name
                                        <span class="text-danger">*</span>
                                    </label>
                                    <select id="ddlTermCondition" class="form-select search_ddl select2" style="margin-top:0px;">
                                    </select>
                                    @* <select id="ddlmaincategory" class="form-select search_ddl select2" aria-label=".form-select-sm">
                                        @*   <select id="ddlmaincategory" class="form-select form-select-sm" aria-label=".form-select-sm">
                                <option value="0" selected> select </option> 

                                    </select> *@
                                    <span class="error text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">
                                        Add New Terms & Condition
                                    </label>

                                    <textarea id="txtTermConditionRemark"
                                              class="form-control"
                                              rows="8"
                                              placeholder="Enter terms and conditions here..."></textarea>

                                    <span class="error text-danger"></span>
                                </div>

                            </div>
                        </div>

                    </div>

                </div>

                <!-- Modal footer -->
                <div class="modal-footer  bg-ld ">

                    <div class="flex-grow-1 text-center modelalert text-danger"></div>

                    <button type="button" class="btn btn-danger  btnModalSubmit">Submit</button>

                </div>

            </div>
        </div>
    </div>

   






}


@section Scripts {
    <script src="~/PageAssets/Hardware/Js/HardwareMaster/PiTermCondition.js" asp-append-version="true"></script>
}