<div class="container ">
    <div id="modalLoader1" class="modal-loader modalLoader">
        <div class="spinner"></div>
        <p class="loading-text">Please wait...</p>
    </div>
    <h4>Purchase Bill Verification </h4>
</div>
<div class="container-fluid">
    <div id="modalLoader1" class="modal-loader modalLoader">
        <div class="spinner"></div>
        <p class="loading-text">Please wait...</p>
    </div>

    <div class="filter-panel mt-5 div-coral-base">
        <div class="form-group row">
            <div class="col-md-3 ">
                <label class="form-label">Month & Year</label>
                <input type="text" id="monthYear" class="form-control" placeholder="MM/YYYY">
                <span class="error text-danger"></span>
            </div>
            <div class="col-md-3 mb-0">
                <label class="form-labelo">Agency<span class="text-danger">*</span></label>
                <select id="ddlAgencyName" class="form-select search_ddl select2" aria-label=".form-select-sm">
                    <option selected value="0">--Select--</option>
                </select>
                <span class="error"></span>
            </div>
            <div class="col-md-3 mb-0">
                <label class="form-labelo">Department Name<span class="text-danger">*</span></label>
                <select id="ddlDeptName" class="form-select search_ddl select2" aria-label=".form-select-sm">
                    <option selected value="0"> -- Select --</option>
                </select>
                <span class="error"></span>
            </div>

            <div class="col-md-3 mb-0">
                <label class="form-labelo">Bill Status<span class="text-danger">*</span></label>
                @* <select id="ddlBillStatus" class="form-select search_ddl select2" aria-label=".form-select-sm"> *@
                <select id="ddlBillStatus" class="form-select" aria-label=".form-select-sm">
                    <option selected value="0"> -- Select --</option>
                    <option value="A"> -- All --</option>
                    <option value="C"> -- Cancel --</option>
                </select>
                <span class="error"></span>
            </div>
        </div>
    </div>

    <div class="container-fluid mt-5">
        @* <h2 class="mb-4">User List</h2> *@
        <div class="filter-panel mt-5 div-coral-base">
            <table id="myTable" class="table orangeTh table-striped table-hover table-bordered">
                <thead class="bg-d">
                    <tr>
                        <th>Sr.No</th>
                        <th>Department Name</th>
                        <th>Agency Name <br> Agency Bill No</th>
                        <th>Attendance</th>
                        <th>Annexure</th>
                        <th>Invoice</th>
                        <th>Bill Date <br> Bill Month <br> Agency Bill Entry Date</th>
                        <th>Agency Bill Verification</th>
                        <th>Verification Status</th>
                        <th>HPSEDE Bill </th>
                        <th>EInvoice</th>
                        <th>Print</th>
                        <th>Cancel Sale Bill</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
                <tfoot class="tfoot bg-primary">
                    <tr>
                        @* <td>3</td>
                    <td>Mike Brown</td>
                    <td>mike@example.com</td>
                    <td>Editor</td>
                    <td>Editor</td> *@
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

